---
import type { Tool } from '../lib/schema';
import { getLogoForTool } from '../lib/ui-helpers';

interface Props {
  tool: Tool;
  size?: 'sm' | 'md' | 'lg';
}

const { tool, size = 'md' } = Astro.props;
const logo = getLogoForTool(tool);

const sizeClasses = {
  sm: 'h-8 w-8 text-xs',
  md: 'h-10 w-10 text-sm',
  lg: 'h-16 w-16 text-xl',
};

const sizeClass = sizeClasses[size];
---

{logo.type === 'icon' ? (
  <span 
    class={`${sizeClass} shrink-0 grid place-items-center rounded-xl bg-white ring-1 ring-zinc-200 dark:ring-zinc-700`}
  >
    <img 
      class="h-1/2 w-1/2" 
      src={`https://cdn.simpleicons.org/${logo.value}`}
      alt={tool.name}
      loading="lazy"
      onerror={`this.parentNode.outerHTML='<span class=\\'${sizeClass} shrink-0 grid place-items-center rounded-xl font-semibold text-white\\' style=\\'background:linear-gradient(135deg,#6366f1,#6366f1aa)\\'>${logo.initials}</span>'`}
    />
  </span>
) : (
  <span 
    class={`${sizeClass} shrink-0 grid place-items-center rounded-xl font-semibold text-white`}
    style={`background:linear-gradient(135deg,${logo.value},${logo.value}aa)`}
  >
    {logo.initials}
  </span>
)}

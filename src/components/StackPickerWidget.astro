---
import Icon from './Icon.astro';

interface Props {
  need?: string;
}

const { need } = Astro.props;

const needParam = need ? `?need=${need}` : '';
---

<div class="rounded-xl border border-zinc-200 p-6 hover:border-indigo-400 transition dark:border-zinc-800">
  <div class="flex flex-col sm:flex-row sm:items-center gap-4">
    <div class="flex-1">
      <h3 class="font-semibold text-zinc-900 dark:text-white flex items-center gap-2">
        <Icon name="sparkles" size={20} class="text-indigo-500" />
        Find tools for your stack
      </h3>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
        Answer a few questions to find tools that match your needs.
      </p>
    </div>
    
    <div class="flex flex-wrap gap-2">
      <a 
        href={`/picker/?platform=web${needParam ? '&' + needParam.slice(1) : ''}`}
        class="inline-flex items-center rounded-lg border border-zinc-300 px-3 py-1.5 text-sm font-medium hover:border-indigo-400 hover:bg-indigo-50 dark:border-zinc-700 dark:hover:bg-indigo-500/10"
      >
        Web app
      </a>
      <a 
        href={`/picker/?platform=rn${needParam ? '&' + needParam.slice(1) : ''}`}
        class="inline-flex items-center rounded-lg border border-zinc-300 px-3 py-1.5 text-sm font-medium hover:border-indigo-400 hover:bg-indigo-50 dark:border-zinc-700 dark:hover:bg-indigo-500/10"
      >
        React Native
      </a>
      <a 
        href={`/picker/?platform=node${needParam ? '&' + needParam.slice(1) : ''}`}
        class="inline-flex items-center rounded-lg border border-zinc-300 px-3 py-1.5 text-sm font-medium hover:border-indigo-400 hover:bg-indigo-50 dark:border-zinc-700 dark:hover:bg-indigo-500/10"
      >
        Node.js
      </a>
      <a 
        href={`/picker/?platform=backend${needParam ? '&' + needParam.slice(1) : ''}`}
        class="inline-flex items-center rounded-lg border border-zinc-300 px-3 py-1.5 text-sm font-medium hover:border-indigo-400 hover:bg-indigo-50 dark:border-zinc-700 dark:hover:bg-indigo-500/10"
      >
        Other backend
      </a>
      <a 
        href={`/picker/${needParam}`}
        class="inline-flex items-center gap-1 rounded-lg bg-zinc-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900"
      >
        See matches
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</div>

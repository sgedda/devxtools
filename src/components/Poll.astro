---
interface Props {
  pollSlug: string;
}

const { pollSlug } = Astro.props;
---

<div class="poll-widget" data-poll-slug={pollSlug}>
  <div class="poll-loading" role="status" aria-live="polite">
    <div class="text-center text-zinc-500">Loading poll...</div>
  </div>

  <div class="poll-error hidden" role="alert">
    <div class="rounded-lg bg-red-50 border border-red-200 p-4 text-red-800 dark:bg-red-900/20 dark:border-red-800 dark:text-red-200">
      <p class="font-medium">Failed to load poll</p>
      <p class="mt-1 text-sm poll-error-message">Please try again later.</p>
    </div>
  </div>

  <form class="poll-form hidden" aria-labelledby="poll-question">
    <fieldset>
      <legend id="poll-question" class="text-xl font-semibold text-zinc-900 dark:text-white mb-4"></legend>
      
      <div class="poll-options space-y-2 mb-6"></div>

      <button 
        type="submit" 
        class="w-full rounded-lg bg-zinc-900 px-4 py-3 text-base font-medium text-white hover:bg-zinc-700 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200 dark:focus:ring-white"
      >
        Vote
      </button>
    </fieldset>

    <p class="mt-4 text-sm text-zinc-500 text-center">Vote to see results</p>
  </form>

  <div class="poll-results hidden">
    <h3 id="poll-results-heading" class="text-xl font-semibold text-zinc-900 dark:text-white mb-4"></h3>
    
    <div class="poll-results-list space-y-4 mb-6" aria-live="polite" aria-atomic="true"></div>
    
    <p class="poll-total-votes text-sm text-zinc-600 dark:text-zinc-400 text-center"></p>
  </div>
</div>

<style>
  .poll-option-wrapper {
    position: relative;
  }

  .poll-option-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border: 2px solid rgb(228 228 231);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.2s;
    background: white;
  }

  :global(.dark) .poll-option-label {
    background: rgb(24 24 27);
    border-color: rgb(63 63 70);
  }

  .poll-option-label:hover {
    border-color: rgb(161 161 170);
  }

  :global(.dark) .poll-option-label:hover {
    border-color: rgb(113 113 122);
  }

  .poll-option-input:checked + .poll-option-label {
    border-color: rgb(39 39 42);
    background: rgb(250 250 250);
  }

  :global(.dark) .poll-option-input:checked + .poll-option-label {
    border-color: white;
    background: rgb(39 39 42);
  }

  .poll-option-input:focus-visible + .poll-option-label {
    outline: 2px solid rgb(39 39 42);
    outline-offset: 2px;
  }

  :global(.dark) .poll-option-input:focus-visible + .poll-option-label {
    outline-color: white;
  }

  .poll-option-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .poll-option-radio {
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid rgb(161 161 170);
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .poll-option-input:checked ~ .poll-option-radio::after {
    content: '';
    width: 0.625rem;
    height: 0.625rem;
    background: rgb(39 39 42);
    border-radius: 50%;
  }

  :global(.dark) .poll-option-input:checked ~ .poll-option-radio::after {
    background: white;
  }

  .poll-result-item {
    position: relative;
  }

  .poll-result-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background: linear-gradient(90deg, rgb(228 228 231) 0%, rgb(244 244 245) 100%);
    border-radius: 0.5rem;
    transition: width 0.5s ease-out;
    z-index: 0;
  }

  :global(.dark) .poll-result-bar {
    background: linear-gradient(90deg, rgb(39 39 42) 0%, rgb(63 63 70) 100%);
  }

  .poll-result-content {
    position: relative;
    z-index: 1;
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .poll-result-label {
    font-medium;
    color: rgb(39 39 42);
  }

  :global(.dark) .poll-result-label {
    color: rgb(250 250 250);
  }

  .poll-result-stats {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.875rem;
    color: rgb(113 113 122);
  }

  :global(.dark) .poll-result-stats {
    color: rgb(161 161 170);
  }

  .poll-result-percentage {
    font-weight: 600;
    color: rgb(39 39 42);
  }

  :global(.dark) .poll-result-percentage {
    color: white;
  }
</style>

<script>
  interface PollOption {
    slug: string;
    label: string;
    tool_slug: string | null;
    count?: number;
    percentage?: number;
  }

  interface PollData {
    slug: string;
    question: string;
    options: PollOption[];
    has_voted: boolean;
    total_votes?: number;
  }

  interface VoteResult {
    success: boolean;
    results: {
      slug: string;
      question: string;
      total_votes: number;
      options: PollOption[];
    };
  }

  interface ErrorResponse {
    error: string;
    code?: string;
  }

  class PollWidget {
    private container: HTMLElement;
    private pollSlug: string;
    private loading: HTMLElement | null;
    private errorContainer: HTMLElement | null;
    private errorMessage: HTMLElement | null;
    private form: HTMLFormElement | null;
    private results: HTMLElement | null;

    constructor(container: HTMLElement) {
      this.container = container;
      this.pollSlug = container.dataset.pollSlug || '';
      this.loading = container.querySelector('.poll-loading');
      this.errorContainer = container.querySelector('.poll-error');
      this.errorMessage = container.querySelector('.poll-error-message');
      this.form = container.querySelector('.poll-form');
      this.results = container.querySelector('.poll-results');

      this.init();
    }

    private async init() {
      try {
        const data = await this.fetchPoll();
        if (data.has_voted) {
          this.renderResults(data);
        } else {
          this.renderForm(data);
        }
      } catch (error) {
        this.showError(error instanceof Error ? error.message : 'Failed to load poll');
      }
    }

    private async fetchPoll(): Promise<PollData> {
      try {
        const response = await fetch(`/api/polls/${this.pollSlug}`, {
          credentials: 'same-origin',
        });

        if (!response.ok) {
          if (response.status === 404) {
            throw new Error('Poll not found. This poll may have ended or been removed.');
          } else if (response.status === 503) {
            throw new Error('The voting system is currently being configured. Please try again later.');
          } else {
            throw new Error('Failed to load poll. Please try again later.');
          }
        }

        return response.json();
      } catch (error) {
        if (error instanceof TypeError) {
          throw new Error('Network error. Please check your connection and try again.');
        }
        throw error;
      }
    }

    private renderForm(data: PollData) {
      this.loading?.classList.add('hidden');
      this.form?.classList.remove('hidden');

      const question = this.form?.querySelector('#poll-question');
      if (question) {
        question.textContent = data.question;
      }

      const optionsContainer = this.form?.querySelector('.poll-options');
      if (optionsContainer) {
        optionsContainer.innerHTML = data.options
          .map(
            (option, index) => `
          <div class="poll-option-wrapper">
            <input 
              type="radio" 
              name="option" 
              value="${option.slug}" 
              id="option-${index}" 
              class="poll-option-input"
              required
            />
            <label for="option-${index}" class="poll-option-label">
              <span class="poll-option-radio"></span>
              <span class="flex-1">${option.label}</span>
            </label>
          </div>
        `
          )
          .join('');
      }

      this.form?.addEventListener('submit', (e) => this.handleSubmit(e));
    }

    private async handleSubmit(e: Event) {
      e.preventDefault();

      const formData = new FormData(this.form!);
      const option = formData.get('option') as string;

      if (!option) {
        return;
      }

      const submitButton = this.form?.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Voting...';
      }

      try {
        const response = await fetch(`/api/polls/${this.pollSlug}/vote`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'same-origin',
          body: JSON.stringify({ option }),
        });

        const data: VoteResult | ErrorResponse = await response.json();

        if (!response.ok) {
          const errorData = data as ErrorResponse;
          if (response.status === 409 && errorData.code === 'ALREADY_VOTED') {
            this.showError('You have already voted in this poll.');
          } else if (response.status === 429 && errorData.code === 'RATE_LIMITED') {
            this.showError('Too many requests. Please try again in a minute.');
          } else if (response.status === 503 && errorData.code === 'NOT_CONFIGURED') {
            this.showError('The voting system is currently being configured. Please try again later.');
          } else if (response.status === 400 && errorData.code === 'INVALID_CAPTCHA') {
            this.showError('Captcha verification failed. Please refresh the page and try again.');
          } else {
            this.showError(errorData.error || 'Failed to submit vote. Please try again.');
          }
          return;
        }

        const voteData = data as VoteResult;
        this.form?.classList.add('hidden');
        this.renderResults({
          slug: voteData.results.slug,
          question: voteData.results.question,
          options: voteData.results.options,
          has_voted: true,
          total_votes: voteData.results.total_votes,
        });
      } catch (error) {
        if (error instanceof TypeError) {
          this.showError('Network error. Please check your connection and try again.');
        } else {
          this.showError('Failed to submit vote. Please try again.');
        }
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = 'Vote';
        }
      }
    }

    private renderResults(data: PollData) {
      this.loading?.classList.add('hidden');
      this.results?.classList.remove('hidden');

      const heading = this.results?.querySelector('#poll-results-heading');
      if (heading) {
        heading.textContent = data.question;
      }

      const resultsList = this.results?.querySelector('.poll-results-list');
      if (resultsList) {
        resultsList.innerHTML = data.options
          .map(
            (option) => `
          <div class="poll-result-item">
            <div class="poll-result-bar" style="width: ${option.percentage || 0}%"></div>
            <div class="poll-result-content">
              <span class="poll-result-label">${option.label}</span>
              <span class="poll-result-stats">
                <span class="poll-result-percentage">${option.percentage || 0}%</span>
                <span>${option.count || 0} ${(option.count || 0) === 1 ? 'vote' : 'votes'}</span>
              </span>
            </div>
          </div>
        `
          )
          .join('');
      }

      const totalVotes = this.results?.querySelector('.poll-total-votes');
      if (totalVotes) {
        const count = data.total_votes || 0;
        totalVotes.textContent = `${count} total ${count === 1 ? 'vote' : 'votes'}`;
      }
    }

    private showError(message: string) {
      this.loading?.classList.add('hidden');
      this.errorContainer?.classList.remove('hidden');
      if (this.errorMessage) {
        this.errorMessage.textContent = message;
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const widgets = document.querySelectorAll('.poll-widget');
    widgets.forEach((widget) => {
      if (widget instanceof HTMLElement) {
        new PollWidget(widget);
      }
    });
  });
</script>

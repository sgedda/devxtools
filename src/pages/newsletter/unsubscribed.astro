---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Unsubscribed" 
  description="You've been unsubscribed from the DevX Tools newsletter."
  noindex={true}
>
  
  <div class="container">
    <div class="message-card">
      <div class="icon info">✉</div>
      <h1>You've Been Unsubscribed</h1>
      <p class="lead">
        You won't receive any more emails from the DevX Tools newsletter.
      </p>
      <p>
        Sorry to see you go! If you change your mind, you can always resubscribe from our website.
      </p>
      <div class="actions">
        <a href="/" class="button">Back to Home</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .message-card {
    max-width: 600px;
    margin: 4rem auto;
    text-align: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 3rem 2rem;
  }

  .icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-weight: bold;
  }

  .icon.info {
    background: rgba(88, 166, 255, 0.1);
    color: var(--accent);
    border: 2px solid var(--accent);
  }

  h1 {
    margin-bottom: 1rem;
    color: var(--text);
  }

  .lead {
    font-size: 1.25rem;
    color: var(--text);
    margin-bottom: 1rem;
  }

  p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
  }
</style>

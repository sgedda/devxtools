---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Pick a Tool" 
  description="Find the right API mocking or test data tool for your project with our interactive tool picker."
>
  <div class="container">
    <h1>Pick the Right Tool</h1>
    <p class="subtitle">
      Answer a few questions to find the best API mocking or test data tool for your needs.
    </p>
    
    <div class="picker-container">
      <div id="questions">
        <div class="question active" data-question="1">
          <h2>What do you need?</h2>
          <div class="options">
            <button class="option" data-answer="mocking" data-next="2">
              API Mocking / HTTP Interception
            </button>
            <button class="option" data-answer="test-data" data-next="5">
              Test Data Generation
            </button>
            <button class="option" data-answer="contract" data-next="result-pact">
              Contract Testing
            </button>
          </div>
        </div>
        
        <div class="question" data-question="2">
          <h2>Where are you running tests?</h2>
          <div class="options">
            <button class="option" data-answer="node-only" data-next="3">
              Node.js only
            </button>
            <button class="option" data-answer="browser-only" data-next="result-msw">
              Browser only
            </button>
            <button class="option" data-answer="both" data-next="4">
              Both Node.js and Browser
            </button>
          </div>
        </div>
        
        <div class="question" data-question="3">
          <h2>Do you need record/replay functionality?</h2>
          <div class="options">
            <button class="option" data-answer="yes-record" data-next="result-nock-polly">
              Yes, I want to record real API calls
            </button>
            <button class="option" data-answer="no-record" data-next="result-nock">
              No, I'll write mocks manually
            </button>
          </div>
        </div>
        
        <div class="question" data-question="4">
          <h2>Do you need record/replay functionality?</h2>
          <div class="options">
            <button class="option" data-answer="yes-record-both" data-next="result-polly">
              Yes, record/replay is important
            </button>
            <button class="option" data-answer="no-record-both" data-next="result-msw">
              No, manual mocking is fine
            </button>
          </div>
        </div>
        
        <div class="question" data-question="5">
          <h2>What type of test data do you need?</h2>
          <div class="options">
            <button class="option" data-answer="simple-data" data-next="result-faker">
              Simple random data (names, emails, etc.)
            </button>
            <button class="option" data-answer="complex-data" data-next="result-fishery">
              Complex object factories
            </button>
            <button class="option" data-answer="bulk-data" data-next="result-mockaroo">
              Large datasets (CSV, SQL export)
            </button>
          </div>
        </div>
      </div>
      
      <div id="results" style="display: none;">
        <div class="result" data-result="result-msw">
          <h2>We recommend: MSW</h2>
          <p>Mock Service Worker is perfect for modern full-stack applications. It works in both browsers and Node.js with the same API.</p>
          <div class="result-actions">
            <a href="/tools/msw/" class="button">View MSW Details →</a>
            <button class="button button-secondary" onclick="resetPicker()">Start Over</button>
          </div>
        </div>
        
        <div class="result" data-result="result-nock">
          <h2>We recommend: Nock</h2>
          <p>Nock is the simplest HTTP mocking library for Node.js. Perfect for straightforward API testing.</p>
          <div class="result-actions">
            <a href="/tools/nock/" class="button">View Nock Details →</a>
            <button class="button button-secondary" onclick="resetPicker()">Start Over</button>
          </div>
        </div>
        
        <div class="result" data-result="result-nock-polly">
          <h2>We recommend: Nock or Polly.js</h2>
          <p>Both Nock and Polly.js offer record/replay functionality for Node.js. Nock is simpler, while Polly.js has more advanced features.</p>
          <div class="result-actions">
            <a href="/tools/nock/" class="button">View Nock →</a>
            <a href="/tools/pollyjs/" class="button">View Polly.js →</a>
            <button class="button button-secondary" onclick="resetPicker()">Start Over</button>
          </div>
        </div>
        
        <div class="result" data-result="result-polly">
          <h2>We recommend: Polly.js</h2>
          <p>Polly.js provides powerful record/replay capabilities for both Node.js and browser environments.</p>
          <div class="result-actions">
            <a href="/tools/pollyjs/" class="button">View Polly.js Details →</a>
            <button class="button button-secondary" onclick="resetPicker()">Start Over</button>
          </div>
        </div>
        
        <div class="result" data-result="result-pact">
          <h2>We recommend: Pact</h2>
          <p>Pact is the industry-standard tool for consumer-driven contract testing across multiple languages.</p>
          <div class="result-actions">
            <a href="/tools/pact/" class="button">View Pact Details →</a>
            <button class="button button-secondary" onclick="resetPicker()">Start Over</button>
          </div>
        </div>
        
        <div class="result" data-result="result-faker">
          <h2>We recommend: Faker</h2>
          <p>Faker.js is the most popular library for generating realistic fake data in JavaScript.</p>
          <div class="result-actions">
            <a href="/tools/faker/" class="button">View Faker Details →</a>
            <button class="button button-secondary" onclick="resetPicker()">Start Over</button>
          </div>
        </div>
        
        <div class="result" data-result="result-fishery">
          <h2>We recommend: Fishery + Faker</h2>
          <p>Combine Fishery's type-safe factories with Faker for generating complex test objects.</p>
          <div class="result-actions">
            <a href="/tools/fishery/" class="button">View Fishery →</a>
            <a href="/tools/faker/" class="button">View Faker →</a>
            <button class="button button-secondary" onclick="resetPicker()">Start Over</button>
          </div>
        </div>
        
        <div class="result" data-result="result-mockaroo">
          <h2>We recommend: Mockaroo</h2>
          <p>Mockaroo is perfect for generating large datasets in multiple formats via its web interface or API.</p>
          <div class="result-actions">
            <a href="/tools/mockaroo/" class="button">View Mockaroo Details →</a>
            <button class="button button-secondary" onclick="resetPicker()">Start Over</button>
          </div>
        </div>
      </div>
      
      <div class="picker-footer">
        <button id="back-button" class="button button-secondary" style="display: none;">
          ← Back
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .subtitle {
    color: var(--text-secondary);
    margin-bottom: 3rem;
    font-size: 1.25rem;
    text-align: center;
  }
  
  .picker-container {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .question {
    display: none;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 3rem;
    text-align: center;
  }
  
  .question.active {
    display: block;
  }
  
  .question h2 {
    margin-bottom: 2rem;
    font-size: 1.75rem;
  }
  
  .options {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .option {
    padding: 1.5rem;
    background: var(--bg);
    border: 2px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
  }
  
  .option:hover {
    border-color: var(--accent);
    transform: translateX(4px);
  }
  
  .result {
    display: none;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 3rem;
    text-align: center;
  }
  
  .result.active {
    display: block;
  }
  
  .result h2 {
    color: var(--accent);
    margin-bottom: 1.5rem;
    font-size: 2rem;
  }
  
  .result p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 2rem;
    line-height: 1.8;
  }
  
  .result-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .picker-footer {
    margin-top: 2rem;
    text-align: center;
  }
  
  @media (max-width: 768px) {
    .question, .result {
      padding: 2rem 1.5rem;
    }
    
    .question h2, .result h2 {
      font-size: 1.5rem;
    }
    
    .option {
      font-size: 1rem;
    }
  }
</style>

<script is:inline>
  let history = [];
  
  function showQuestion(questionNumber) {
    document.querySelectorAll('.question').forEach(q => {
      q.classList.remove('active');
    });
    
    const question = document.querySelector(`[data-question="${questionNumber}"]`);
    if (question) {
      question.classList.add('active');
      updateBackButton();
    }
  }
  
  function showResult(resultId) {
    document.getElementById('questions').style.display = 'none';
    document.getElementById('results').style.display = 'block';
    
    document.querySelectorAll('.result').forEach(r => {
      r.classList.remove('active');
    });
    
    const result = document.querySelector(`[data-result="${resultId}"]`);
    if (result) {
      result.classList.add('active');
      updateBackButton();
    }
  }
  
  function updateBackButton() {
    const backButton = document.getElementById('back-button');
    if (history.length > 0) {
      backButton.style.display = 'inline-block';
    } else {
      backButton.style.display = 'none';
    }
  }
  
  function goBack() {
    if (history.length > 0) {
      const previous = history.pop();
      
      document.getElementById('results').style.display = 'none';
      document.getElementById('questions').style.display = 'block';
      
      showQuestion(previous);
    }
  }
  
  function resetPicker() {
    history = [];
    document.getElementById('results').style.display = 'none';
    document.getElementById('questions').style.display = 'block';
    showQuestion(1);
  }
  
  // Set up option click handlers
  document.querySelectorAll('.option').forEach(option => {
    option.addEventListener('click', function() {
      const next = this.getAttribute('data-next');
      const currentQuestion = this.closest('.question').getAttribute('data-question');
      
      history.push(currentQuestion);
      
      if (next.startsWith('result-')) {
        showResult(next);
      } else {
        showQuestion(next);
      }
    });
  });
  
  // Set up back button
  document.getElementById('back-button').addEventListener('click', goBack);
  
  // Make resetPicker globally available
  window.resetPicker = resetPicker;
</script>

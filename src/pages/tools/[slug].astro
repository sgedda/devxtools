---
import Layout from '../../layouts/Layout.astro';
import { getAllTools, getToolBySlug } from '../../lib/tools';
import { CATEGORY_LABELS } from '../../lib/schema';

export async function getStaticPaths() {
  const tools = getAllTools();
  return tools.map(tool => ({
    params: { slug: tool.slug },
  }));
}

const { slug } = Astro.params;
const tool = getToolBySlug(slug!);

if (!tool) {
  return new Response(null, { status: 404 });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": tool.name,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": tool.runtimes.join(", "),
      "url": `https://devxtools.dev/tools/${tool.slug}/`,
      "description": tool.description,
      ...(tool.repo && { "codeRepository": tool.repo }),
      ...(tool.license && { "license": tool.license })
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://devxtools.dev/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Catalog",
          "item": "https://devxtools.dev/catalog/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": tool.name,
          "item": `https://devxtools.dev/tools/${tool.slug}/`
        }
      ]
    }
  ]
};
---

<Layout 
  title={`${tool.name}: Setup, Example & Alternatives`}
  description={tool.bestFor}
  jsonLd={jsonLd}
>
  <div class="container">
    <article class="tool-page">
      <header class="tool-header">
        <div class="tool-title-row">
          <h1>{tool.name}</h1>
          {tool.license && <span class="license">{tool.license}</span>}
        </div>
        <p class="tool-tagline">{tool.bestFor}</p>
      </header>
      
      {tool.affiliation && (
        <aside class="affiliation-disclosure">
          <strong>⚠️ Disclosure:</strong> {tool.affiliation}
        </aside>
      )}
      
      <section class="tool-description">
        <h2>Overview</h2>
        <p>{tool.description}</p>
      </section>
      
      <section class="tool-details">
        <h2>Details</h2>
        
        <div class="detail-grid">
          <div class="detail-item">
            <h3>Languages</h3>
            <div class="badge-list">
              {tool.languages.map(lang => (
                <span class="badge">{lang}</span>
              ))}
            </div>
          </div>
          
          <div class="detail-item">
            <h3>Runtimes</h3>
            <div class="badge-list">
              {tool.runtimes.map(runtime => (
                <span class="badge">{runtime}</span>
              ))}
            </div>
          </div>
          
          <div class="detail-item">
            <h3>Categories</h3>
            <div class="badge-list">
              {tool.categories.map(cat => (
                <span class="badge">{CATEGORY_LABELS[cat]}</span>
              ))}
            </div>
          </div>
          
          {tool.specSupport && tool.specSupport.length > 0 && (
            <div class="detail-item">
              <h3>Spec Support</h3>
              <div class="badge-list">
                {tool.specSupport.map(spec => (
                  <span class="badge badge-success">{spec}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
      
      <section class="tool-links-section">
        <h2>Links</h2>
        <div class="link-cards">
          <a href={tool.website} target="_blank" rel="noopener noreferrer" class="link-card">
            <strong>🌐 Official Website</strong>
            <span>{tool.website}</span>
          </a>
          {tool.repo && (
            <a href={tool.repo} target="_blank" rel="noopener noreferrer" class="link-card">
              <strong>📦 Repository</strong>
              <span>{tool.repo}</span>
            </a>
          )}
        </div>
      </section>
      
      <footer class="tool-footer">
        <p class="last-checked">Last checked: {tool.lastChecked}</p>
        <a href="/catalog/" class="button">← Back to Catalog</a>
      </footer>
    </article>
  </div>
</Layout>

<style>
  .tool-page {
    max-width: 900px;
    margin: 0 auto;
  }
  
  .tool-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  
  .tool-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  
  .tool-title-row h1 {
    margin: 0;
    font-size: 3rem;
  }
  
  .license {
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding: 0.5rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  
  .tool-tagline {
    font-size: 1.25rem;
    color: var(--accent);
    margin: 0;
  }
  
  .affiliation-disclosure {
    background: rgba(210, 153, 34, 0.1);
    border: 1px solid var(--warning);
    border-radius: 8px;
    padding: 1rem 1.5rem;
    margin: 2rem 0;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  
  .affiliation-disclosure strong {
    color: var(--warning);
  }
  
  .tool-description {
    margin-bottom: 3rem;
  }
  
  .tool-description p {
    font-size: 1.1rem;
    line-height: 1.8;
  }
  
  .tool-details {
    margin-bottom: 3rem;
  }
  
  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }
  
  .detail-item h3 {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .tool-links-section {
    margin-bottom: 3rem;
  }
  
  .link-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .link-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
  }
  
  .link-card:hover {
    border-color: var(--accent);
    transform: translateX(4px);
  }
  
  .link-card strong {
    color: var(--text);
    font-size: 1.1rem;
  }
  
  .link-card span {
    color: var(--text-secondary);
    font-size: 0.95rem;
    word-break: break-all;
  }
  
  .tool-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  
  .last-checked {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin: 0;
  }
  
  @media (max-width: 768px) {
    .tool-title-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    
    .tool-title-row h1 {
      font-size: 2rem;
    }
    
    .detail-grid {
      grid-template-columns: 1fr;
    }
    
    .tool-footer {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
  }
</style>

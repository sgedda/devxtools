---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import { getAllTools, getToolBySlug } from '../../lib/tools';
import { getToolContentLinks } from '../../lib/content-links';
import { CATEGORY_LABELS } from '../../lib/schema';
import { formatTimeAgo, getLicenseBadgeClass } from '../../lib/ui-helpers';

export async function getStaticPaths() {
  const tools = getAllTools();
  return tools.map(tool => ({
    params: { slug: tool.slug },
  }));
}

const { slug } = Astro.params;
const tool = getToolBySlug(slug!);

if (!tool) {
  return new Response(null, { status: 404 });
}

const allTools = getAllTools();

const contentLinks = getToolContentLinks(slug!);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": tool.name,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": tool.runtimes.join(", "),
      "url": `https://devxtools.dev/tools/${tool.slug}/`,
      "description": tool.description,
      ...(tool.repo && { "codeRepository": tool.repo }),
      ...(tool.license && { "license": tool.license })
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://devxtools.dev/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Catalog",
          "item": "https://devxtools.dev/catalog/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": tool.name,
          "item": `https://devxtools.dev/tools/${tool.slug}/`
        }
      ]
    }
  ]
};

// Find related tools (same primary category, different tool)
const relatedTools = allTools
  .filter(t => 
    t.slug !== tool.slug && 
    t.categories.some(c => tool.categories.includes(c))
  )
  .slice(0, 3);
---

<Layout 
  title={`${tool.name}: Setup, Example & Alternatives`}
  description={tool.bestFor}
  jsonLd={jsonLd}
>
  <div class="border-b border-zinc-200 bg-gradient-to-b from-indigo-50/60 to-transparent dark:border-zinc-800 dark:from-indigo-500/5">
    <div class="mx-auto max-w-[1200px] px-5 py-10">
      <nav class="flex items-center gap-1.5 text-sm text-zinc-500">
        <a href="/" class="hover:text-zinc-900 dark:hover:text-white">Home</a>
        <Icon name="chevron-right" size={14} />
        <a href="/catalog/" class="hover:text-zinc-900 dark:hover:text-white">Catalog</a>
        <Icon name="chevron-right" size={14} />
        <a href={`/catalog/?category=${tool.categories[0]}`} class="hover:text-zinc-900 dark:hover:text-white">
          {CATEGORY_LABELS[tool.categories[0]]}
        </a>
        <Icon name="chevron-right" size={14} />
        <span class="text-zinc-900 dark:text-white">{tool.name}</span>
      </nav>
      
      <div class="mt-6 flex flex-col gap-6 md:flex-row md:items-center">
        <ToolLogo tool={tool} size="lg" />
        
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-zinc-900 dark:text-white">
              {tool.name}
            </h1>
            {tool.license && (
              <span class={`inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-medium ${getLicenseBadgeClass(tool.license)}`}>
                {tool.license}
              </span>
            )}
          </div>
          <p class="mt-2 text-lg text-zinc-600 dark:text-zinc-400">{tool.description}</p>
        </div>
        
        <div class="flex flex-wrap gap-3">
          <a 
            href={tool.website}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-3 font-medium text-white shadow-sm hover:bg-indigo-500"
          >
            <Icon name="globe" size={16} />
            Website
            <Icon name="arrow-up-right" size={16} />
          </a>
          {tool.repo && (
            <a 
              href={tool.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-5 py-3 font-medium text-zinc-900 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-white"
            >
              <Icon name="git-fork" size={16} />
              Repository
              <Icon name="arrow-up-right" size={16} />
            </a>
          )}
        </div>
      </div>
    </div>
  </div>

  <main class="mx-auto max-w-[1200px] px-5 py-12 grid gap-10 lg:grid-cols-[1fr_320px]">
    <article class="min-w-0 space-y-10">
      {tool.affiliation && (
        <aside class="rounded-lg border-2 border-amber-300 bg-amber-50 p-4 dark:border-amber-700/50 dark:bg-amber-900/10">
          <p class="text-sm text-amber-900 dark:text-amber-200">
            <strong class="font-semibold">⚠️ Disclosure:</strong> {tool.affiliation}
          </p>
        </aside>
      )}
      
      <section>
        <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Overview</h2>
        <p class="mt-3 text-[16px] leading-7 text-zinc-600 dark:text-zinc-400">
          {tool.description}
        </p>
        
        {tool.whenToUse && (
          <div class="mt-5 rounded-xl border border-indigo-200 bg-indigo-50/60 p-5 dark:border-indigo-500/30 dark:bg-indigo-500/5">
            <div class="flex items-center gap-2 font-medium text-indigo-900 dark:text-indigo-200">
              <Icon name="lightbulb" size={16} />
              When to use it
            </div>
            <p class="mt-1.5 text-[15px] text-indigo-900/80 dark:text-indigo-200/80">
              {tool.whenToUse}
            </p>
          </div>
        )}
      </section>
      
      <section>
        <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Details</h2>
        
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-zinc-200 p-5 dark:border-zinc-800">
            <h3 class="font-medium text-zinc-900 dark:text-white">Languages & Runtimes</h3>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {tool.languages.map(lang => (
                <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-sm text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                  {lang}
                </span>
              ))}
            </div>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {tool.runtimes.map(runtime => (
                <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-sm text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                  {runtime}
                </span>
              ))}
            </div>
          </div>
          
          <div class="rounded-xl border border-zinc-200 p-5 dark:border-zinc-800">
            <h3 class="font-medium text-zinc-900 dark:text-white">Categories</h3>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {tool.categories.map(cat => (
                <span class="rounded-md bg-indigo-50 px-2 py-0.5 text-sm text-indigo-700 dark:bg-indigo-500/10 dark:text-indigo-300">
                  {CATEGORY_LABELS[cat]}
                </span>
              ))}
            </div>
          </div>
          
          {tool.specSupport && tool.specSupport.length > 0 && (
            <div class="rounded-xl border border-zinc-200 p-5 dark:border-zinc-800">
              <h3 class="font-medium text-zinc-900 dark:text-white">Spec Support</h3>
              <div class="mt-2 flex flex-wrap gap-1.5">
                {tool.specSupport.map(spec => (
                  <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-sm text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300">
                    {spec}
                  </span>
                ))}
              </div>
            </div>
          )}
          
          <div class="rounded-xl border border-zinc-200 p-5 dark:border-zinc-800">
            <h3 class="font-medium text-zinc-900 dark:text-white">Best For</h3>
            <p class="mt-2 text-[15px] text-zinc-600 dark:text-zinc-400">
              {tool.bestFor}
            </p>
          </div>
        </div>
      </section>
      
      {relatedTools.length > 0 && (
        <section>
          <div class="flex items-end justify-between">
            <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Related tools</h2>
            <a 
              href={`/catalog/?category=${tool.categories[0]}`}
              class="text-sm font-medium text-indigo-600 dark:text-indigo-400"
            >
              View all in {CATEGORY_LABELS[tool.categories[0]]} →
            </a>
          </div>
          
          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            {relatedTools.map(related => (
              <a 
                href={`/tools/${related.slug}/`}
                class="rounded-xl border border-zinc-200 p-4 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
              >
                <div class="flex items-center gap-3">
                  <ToolLogo tool={related} size="sm" />
                  <div class="font-medium text-zinc-900 dark:text-white">{related.name}</div>
                </div>
                <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2">
                  {related.bestFor}
                </p>
              </a>
            ))}
          </div>
        </section>
      )}
      
      <section>
        <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Get the badge</h2>
        <p class="mt-2 text-[15px] text-zinc-600 dark:text-zinc-400">
          Show that {tool.name} is featured on DevX Tools by adding this badge to your README or website.
        </p>
        
        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <div class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="text-sm font-medium text-zinc-900 dark:text-white mb-3">Small · Light theme</div>
            <div class="flex items-center justify-center rounded-lg bg-zinc-50 p-6 dark:bg-zinc-800">
              <img src={`/badge/${tool.slug}.svg`} alt="Featured on devxtools badge" />
            </div>
          </div>
          
          <div class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="text-sm font-medium text-zinc-900 dark:text-white mb-3">Small · Dark theme</div>
            <div class="flex items-center justify-center rounded-lg bg-zinc-900 p-6">
              <img src={`/badge/${tool.slug}.svg?theme=dark`} alt="Featured on devxtools badge (dark)" />
            </div>
          </div>
          
          <div class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="text-sm font-medium text-zinc-900 dark:text-white mb-3">Large · Light theme</div>
            <div class="flex items-center justify-center rounded-lg bg-zinc-50 p-6 dark:bg-zinc-800">
              <img src={`/badge/${tool.slug}.svg?variant=large`} alt="Featured on devxtools badge (large)" />
            </div>
          </div>
          
          <div class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="text-sm font-medium text-zinc-900 dark:text-white mb-3">Large · Dark theme</div>
            <div class="flex items-center justify-center rounded-lg bg-zinc-900 p-6">
              <img src={`/badge/${tool.slug}.svg?variant=large&theme=dark`} alt="Featured on devxtools badge (large, dark)" />
            </div>
          </div>
        </div>
        
        <div class="mt-5 space-y-4">
          <div class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex items-center justify-between mb-2">
              <div class="text-sm font-medium text-zinc-900 dark:text-white">Markdown (small, light)</div>
              <button
                onclick="navigator.clipboard.writeText(this.parentElement.nextElementSibling.textContent)"
                class="text-xs text-indigo-600 hover:text-indigo-500 dark:text-indigo-400"
              >
                Copy
              </button>
            </div>
            <pre class="text-xs bg-zinc-50 dark:bg-zinc-800 p-3 rounded-lg overflow-x-auto"><code>[![Featured on devxtools](https://devxtools.dev/badge/{tool.slug}.svg)](https://devxtools.dev/tools/{tool.slug}/)</code></pre>
          </div>
          
          <div class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex items-center justify-between mb-2">
              <div class="text-sm font-medium text-zinc-900 dark:text-white">Markdown (large, dark)</div>
              <button
                onclick="navigator.clipboard.writeText(this.parentElement.nextElementSibling.textContent)"
                class="text-xs text-indigo-600 hover:text-indigo-500 dark:text-indigo-400"
              >
                Copy
              </button>
            </div>
            <pre class="text-xs bg-zinc-50 dark:bg-zinc-800 p-3 rounded-lg overflow-x-auto"><code>[![Featured on devxtools](https://devxtools.dev/badge/{tool.slug}.svg?variant=large&amp;theme=dark)](https://devxtools.dev/tools/{tool.slug}/)</code></pre>
          </div>
          
          <div class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex items-center justify-between mb-2">
              <div class="text-sm font-medium text-zinc-900 dark:text-white">HTML (small, light)</div>
              <button
                onclick="navigator.clipboard.writeText(this.parentElement.nextElementSibling.textContent)"
                class="text-xs text-indigo-600 hover:text-indigo-500 dark:text-indigo-400"
              >
                Copy
              </button>
            </div>
            <pre class="text-xs bg-zinc-50 dark:bg-zinc-800 p-3 rounded-lg overflow-x-auto"><code>&lt;a href="https://devxtools.dev/tools/{tool.slug}/"&gt;&lt;img src="https://devxtools.dev/badge/{tool.slug}.svg" alt="Featured on devxtools" /&gt;&lt;/a&gt;</code></pre>
          </div>
        </div>
      </section>
      
      {(contentLinks.comparisons.length > 0 || contentLinks.guides.length > 0) && (
        <section>
          {contentLinks.comparisons.length > 0 && (
            <div class="mb-8">
              <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Compared in</h2>
              <div class="mt-4 space-y-3">
                {contentLinks.comparisons.map(link => (
                  <a 
                    href={link.url}
                    class="block rounded-xl border border-zinc-200 p-4 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
                  >
                    <div class="flex items-center gap-2">
                      <Icon name="git-compare" size={16} class="text-indigo-600 dark:text-indigo-400" />
                      <span class="font-medium text-zinc-900 dark:text-white">{link.title}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
          
          {contentLinks.guides.length > 0 && (
            <div>
              <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Featured in guides</h2>
              <div class="mt-4 space-y-3">
                {contentLinks.guides.map(link => (
                  <a 
                    href={link.url}
                    class="block rounded-xl border border-zinc-200 p-4 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
                  >
                    <div class="flex items-center gap-2">
                      <Icon name="book-open" size={16} class="text-indigo-600 dark:text-indigo-400" />
                      <span class="font-medium text-zinc-900 dark:text-white">{link.title}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </section>
      )}
    </article>
    
    <aside class="lg:sticky lg:top-24 self-start rounded-xl border border-zinc-200 p-5 dark:border-zinc-800">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500">Quick facts</h2>
      
      <dl class="mt-4 divide-y divide-zinc-100 dark:divide-zinc-800">
        {tool.license && (
          <div class="py-3">
            <dt class="text-sm text-zinc-500">License</dt>
            <dd class="mt-1.5 flex flex-wrap gap-1.5">
              <span class={`inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-medium ${getLicenseBadgeClass(tool.license)}`}>
                {tool.license}
              </span>
            </dd>
          </div>
        )}
        
        <div class="py-3">
          <dt class="text-sm text-zinc-500">Language</dt>
          <dd class="mt-1.5 flex flex-wrap gap-1.5">
            {tool.languages.map(lang => (
              <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-sm text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                {lang}
              </span>
            ))}
          </dd>
        </div>
        
        <div class="py-3">
          <dt class="text-sm text-zinc-500">Runtimes</dt>
          <dd class="mt-1.5 flex flex-wrap gap-1.5">
            {tool.runtimes.map(runtime => (
              <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-sm text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                {runtime}
              </span>
            ))}
          </dd>
        </div>
        
        <div class="py-3">
          <dt class="text-sm text-zinc-500">Categories</dt>
          <dd class="mt-1.5 flex flex-wrap gap-1.5">
            {tool.categories.map(cat => (
              <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-sm text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                {CATEGORY_LABELS[cat]}
              </span>
            ))}
          </dd>
        </div>
        
        {tool.specSupport && tool.specSupport.length > 0 && (
          <div class="py-3">
            <dt class="text-sm text-zinc-500">Spec support</dt>
            <dd class="mt-1.5 flex flex-wrap gap-1.5">
              {tool.specSupport.map(spec => (
                <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-sm text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                  {spec}
                </span>
              ))}
            </dd>
          </div>
        )}
        
        {tool.githubStars && (
          <div class="py-3">
            <dt class="text-sm text-zinc-500">GitHub stars</dt>
            <dd class="mt-1.5 flex flex-wrap gap-1.5">
              <span class="inline-flex items-center gap-1.5 font-medium text-zinc-900 dark:text-white">
                <Icon name="star" size={16} class="text-amber-500" />
                {tool.githubStars.toLocaleString()}
              </span>
            </dd>
          </div>
        )}
        
        {tool.lastActivity && (
          <div class="py-3">
            <dt class="text-sm text-zinc-500">Last updated</dt>
            <dd class="mt-1.5">
              <span class="text-sm text-zinc-900 dark:text-white">
                {new Date(tool.lastActivity).toLocaleDateString('en-GB', { 
                  day: 'numeric', 
                  month: 'short', 
                  year: 'numeric' 
                })} · {formatTimeAgo(tool.lastActivity)}
              </span>
            </dd>
          </div>
        )}
        
        <div class="py-3">
          <dt class="text-sm text-zinc-500">Website</dt>
          <dd class="mt-1.5">
            <a 
              href={tool.website}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-indigo-600 dark:text-indigo-400 break-all hover:underline"
            >
              {tool.website.replace(/^https?:\/\//, '')}
            </a>
          </dd>
        </div>
        
        {tool.repo && (
          <div class="py-3">
            <dt class="text-sm text-zinc-500">Repository</dt>
            <dd class="mt-1.5">
              <a 
                href={tool.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-indigo-600 dark:text-indigo-400 break-all hover:underline"
              >
                {tool.repo.replace('https://github.com/', '')}
              </a>
            </dd>
          </div>
        )}
      </dl>
      
      <div class="mt-5 flex items-center gap-2 rounded-lg bg-zinc-50 px-3 py-2 text-sm text-zinc-500 dark:bg-zinc-900">
        <Icon name="badge-check" size={16} class="text-emerald-500" />
        GitHub data fetched 2026-10-14
      </div>
      
      <a 
        href={`https://github.com/sgedda/devxtools/edit/main/src/data/tools/${tool.slug}.yaml`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 flex items-center gap-2 text-sm text-zinc-500 hover:text-zinc-900 dark:hover:text-white"
      >
        <Icon name="pencil" size={16} />
        Suggest an edit
      </a>
      
      <a 
        href={`/submit/?tool=${tool.slug}&mode=claim`}
        class="mt-2 flex items-center gap-2 text-sm text-zinc-500 hover:text-zinc-900 dark:hover:text-white"
      >
        <Icon name="badge-check" size={16} />
        Claim or update this listing
      </a>
    </aside>
  </main>
</Layout>

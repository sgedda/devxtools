---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import RunIt from '../../components/RunIt.astro';

const allArticles = await getCollection('articles');
const entry = allArticles.find(a => a.data.slug === '/guides/faker-js-test-data-factories/');
if (!entry) throw new Error('Article not found');

const { Content, headings } = await render(entry);
---

<ArticleLayout frontmatter={entry.data} headings={headings}>
  <div id="article-content">
    <Content />
  </div>
  <div class="run-it-wrapper">
    <RunIt project="faker-factories" file="factory.test.js" title="Try Faker.js Factories Live" />
    <p class="demo-caption"><em>Run this Faker.js test example in your browser with StackBlitz (a third-party service).</em></p>
  </div>
  <script is:inline>
    (function() {
      function moveDemo() {
        const paragraphs = document.querySelectorAll('#article-content p');
        const wrapper = document.querySelector('.run-it-wrapper');
        if (!wrapper) return;
        
        for (let p of paragraphs) {
          if (p.textContent.includes('Jest works identically')) {
            p.after(wrapper);
            break;
          }
        }
      }
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', moveDemo);
      } else {
        moveDemo();
      }
    })();
  </script>
</ArticleLayout>

<style>
  .run-it-wrapper {
    margin: 2rem 0;
  }
  
  .demo-caption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-style: italic;
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
---

<Layout 
  title="Keeping Mocks Honest with Pact" 
  description="Use consumer-driven contract testing to ensure your mocks stay in sync with real APIs."
  noindex={true}
>
  <div class="container">
    <article class="guide">
      <header>
        <div class="breadcrumb">
          <a href="/guides/">Guides</a> / Best Practices
        </div>
        <h1>Keeping Mocks Honest with Pact</h1>
        <p class="subtitle">Using contract testing to ensure mocks match reality</p>
      </header>
      
      <div class="guide-content">
        <section>
          <p class="intro">This guide is currently in development. We're preparing detailed content about consumer-driven contract testing with Pact.</p>
        </section>
        
        <section>
          <h2>Coming Soon</h2>
          <p>This guide will cover:</p>
          <ul>
            <li>The problem with traditional mocking</li>
            <li>Introduction to consumer-driven contract testing</li>
            <li>Setting up Pact in your project</li>
            <li>Writing consumer tests with Pact</li>
            <li>Verifying contracts on the provider side</li>
            <li>Using the Pact Broker for contract sharing</li>
            <li>Integrating Pact into CI/CD</li>
          </ul>
        </section>
        
        <section>
          <h2>Related Tools</h2>
          <p>
            <a href="/tools/pact/">Learn more about Pact →</a>
          </p>
        </section>
      </div>
      
      <NewsletterSignup variant="article" />
      
      <footer class="guide-footer">
        <a href="/guides/" class="button">← Back to Guides</a>
      </footer>
    </article>
  </div>
</Layout>

<style>
  .guide {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .breadcrumb {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  
  .breadcrumb a {
    color: var(--accent);
  }
  
  .subtitle {
    color: var(--text-secondary);
    font-size: 1.25rem;
    margin-top: 0.5rem;
  }
  
  .intro {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    padding: 1.5rem;
    border-radius: 8px;
    font-size: 1.1rem;
  }
  
  .guide-content {
    margin: 3rem 0;
  }
  
  .guide-content section {
    margin-bottom: 3rem;
  }
  
  .guide-content ul {
    margin-left: 2rem;
  }
  
  .guide-content li {
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
  }
  
  .guide-footer {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>

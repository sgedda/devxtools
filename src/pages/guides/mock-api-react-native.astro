      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://devxtools.dev/" },
        { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://devxtools.dev/guides/" },
        { "@type": "ListItem", "position": 3, "name": "Mock APIs in React Native", "item": "https://devxtools.dev/guides/mock-api-react-native/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I mock an API in React Native?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In Jest tests, use MSW's setupServer from msw/node with React Native Testing Library. In the running app, either pin msw 2.15 and use msw/native with the URL and TextEncoder polyfills, or point the app's base URL at a mock server such as Prism, Mockoon or WireMock."
          }
        },
        {
          "@type": "Question",
          "name": "Does MSW work with React Native and Expo?",

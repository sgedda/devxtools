---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { extractFaq } from '../../lib/faq';
import RunIt from '../../components/RunIt.astro';
import StepClip from '../../components/StepClip.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  
  return articles
    .filter(entry => entry.data.slug.startsWith('/guides/'))
    .map(entry => {
      const slug = entry.data.slug.replace(/^\/guides\//, '').replace(/\/$/, '');
      return {
        params: { slug },
        props: { entry },
      };
    });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout frontmatter={entry.data} headings={headings} faq={extractFaq(entry.body)}>
  <Content components={{ RunIt, StepClip }} />
</ArticleLayout>

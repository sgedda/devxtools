---
import Layout from '../../layouts/Layout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
---

<Layout 
  title="Spec-First Mocking with Prism and OpenAPI" 
  description="Generate mock servers directly from your OpenAPI specifications using Prism."
>
  <div class="container">
    <article class="guide">
      <header>
        <div class="breadcrumb">
          <a href="/guides/">Guides</a> / Tutorial
        </div>
        <h1>Spec-First Mocking with Prism and OpenAPI</h1>
        <p class="subtitle">Turn your OpenAPI specs into live mock servers</p>
      </header>
      
      <div class="guide-content">
        <section>
          <p class="intro">This guide is currently in development. We're working on comprehensive content about using Prism for spec-based mocking.</p>
        </section>
        
        <section>
          <h2>Coming Soon</h2>
          <p>This guide will cover:</p>
          <ul>
            <li>Installing and setting up Prism</li>
            <li>Creating OpenAPI specifications</li>
            <li>Generating mock servers from specs</li>
            <li>Dynamic examples and validation</li>
            <li>Integrating Prism into your development workflow</li>
            <li>Using Prism in CI/CD pipelines</li>
          </ul>
        </section>
        
        <section>
          <h2>Related Tools</h2>
          <p>
            <a href="/tools/prism/">Learn more about Prism →</a>
          </p>
        </section>
      </div>
      
      <NewsletterSignup variant="article" />
      
      <footer class="guide-footer">
        <a href="/guides/" class="button">← Back to Guides</a>
      </footer>
    </article>
  </div>
</Layout>

<style>
  .guide {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .breadcrumb {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  
  .breadcrumb a {
    color: var(--accent);
  }
  
  .subtitle {
    color: var(--text-secondary);
    font-size: 1.25rem;
    margin-top: 0.5rem;
  }
  
  .intro {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    padding: 1.5rem;
    border-radius: 8px;
    font-size: 1.1rem;
  }
  
  .guide-content {
    margin: 3rem 0;
  }
  
  .guide-content section {
    margin-bottom: 3rem;
  }
  
  .guide-content ul {
    margin-left: 2rem;
  }
  
  .guide-content li {
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
  }
  
  .guide-footer {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>

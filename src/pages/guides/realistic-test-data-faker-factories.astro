---
import Layout from '../../layouts/Layout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
---

<Layout 
  title="Realistic Test Data with Faker and Factories" 
  description="Create maintainable, realistic test data using Faker and factory patterns with Fishery."
  noindex={true}
>
  <div class="container">
    <article class="guide">
      <header>
        <div class="breadcrumb">
          <a href="/guides/">Guides</a> / Best Practices
        </div>
        <h1>Realistic Test Data with Faker and Factories</h1>
        <p class="subtitle">Building maintainable test fixtures with Faker and Fishery</p>
      </header>
      
      <div class="guide-content">
        <section>
          <p class="intro">This guide is currently in development. We're creating comprehensive examples of using Faker with factory patterns.</p>
        </section>
        
        <section>
          <h2>Coming Soon</h2>
          <p>This guide will cover:</p>
          <ul>
            <li>Why realistic test data matters</li>
            <li>Getting started with Faker.js</li>
            <li>Creating reusable factories with Fishery</li>
            <li>Generating complex, related data structures</li>
            <li>Seeding databases for integration tests</li>
            <li>Avoiding test data pitfalls</li>
          </ul>
        </section>
        
        <section>
          <h2>Related Tools</h2>
          <p>
            <a href="/tools/faker/">Faker.js →</a> • 
            <a href="/tools/fishery/">Fishery →</a>
          </p>
        </section>
      </div>
      
      <NewsletterSignup variant="article" />
      
      <footer class="guide-footer">
        <a href="/guides/" class="button">← Back to Guides</a>
      </footer>
    </article>
  </div>
</Layout>

<style>
  .guide {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .breadcrumb {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  
  .breadcrumb a {
    color: var(--accent);
  }
  
  .subtitle {
    color: var(--text-secondary);
    font-size: 1.25rem;
    margin-top: 0.5rem;
  }
  
  .intro {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    padding: 1.5rem;
    border-radius: 8px;
    font-size: 1.1rem;
  }
  
  .guide-content {
    margin: 3rem 0;
  }
  
  .guide-content section {
    margin-bottom: 3rem;
  }
  
  .guide-content ul {
    margin-left: 2rem;
  }
  
  .guide-content li {
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
  }
  
  .guide-footer {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>

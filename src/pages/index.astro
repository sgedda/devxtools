---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ToolLogo from '../components/ToolLogo.astro';
import PollCard from '../components/PollCard.astro';
import StackPickerWidget from '../components/StackPickerWidget.astro';
import { getAllTools } from '../lib/tools';
import { CATEGORY_LABELS } from '../lib/schema';
import { formatTimeAgo, getLicenseBadgeClass, CATEGORY_ICONS } from '../lib/ui-helpers';

const tools = getAllTools();
const categories = Object.entries(CATEGORY_LABELS);

// Count tools per category
const categoryCount = Object.fromEntries(
  categories.map(([key, label]) => [
    key,
    tools.filter(t => t.categories.includes(key as any)).length
  ])
);


// Popular tools (by GitHub stars)
const popularTools = tools
  .filter(t => t.githubStars && t.githubStars > 0)
  .sort((a, b) => (b.githubStars || 0) - (a.githubStars || 0))
  .slice(0, 6);

// Calculate percentage of open source tools
const openSourceTools = tools.filter(t => t.license && t.license !== 'Proprietary');
const openSourcePercentage = Math.round((openSourceTools.length / tools.length) * 100);

// Guide data (in production, this would come from content collections)
const guides = [
  {
    category: 'Comparison',
    title: 'MSW vs Nock vs Polly.js',
    description: 'Compare three popular JavaScript HTTP mocking libraries and find the right fit for your project.',
    tools: 'MSW, Nock, Polly.js',
    url: '/comparisons/msw-vs-nock-vs-polly/'
  },
  {
    category: 'Tutorial',
    title: 'Spec-First Mocking with Prism and OpenAPI',
    description: 'Generate mock servers directly from your OpenAPI specifications using Prism.',
    tools: 'Prism',
    url: '/guides/openapi-mock-server-prism/'
  },
  {
    category: 'Tutorial',
    title: 'Mocking APIs in React Native with Mockifyer',
    description: 'Record and replay HTTP interactions in React Native applications for reliable testing.',
    tools: 'Mockifyer',
    url: '/guides/mock-api-react-native/'
  },
];
---

<Layout 
  title="DevXTools: Compare API, Testing & Mocking Tools"
  description={`Independent, neutral comparisons of ${tools.length} API, testing, mocking and observability tools. Filter by language and license, or pick tools for your stack.`}
>
  <section class="relative overflow-hidden border-b border-zinc-200 dark:border-zinc-800">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(99,102,241,.18),transparent_60%)]"></div>
    <div class="pointer-events-none absolute inset-0 opacity-40 dark:opacity-20 [background-image:linear-gradient(#e4e4e7_1px,transparent_1px),linear-gradient(90deg,#e4e4e7_1px,transparent_1px)] [background-size:48px_48px] [mask-image:radial-gradient(ellipse_at_top,black,transparent_70%)]"></div>
    
    <div class="relative mx-auto max-w-[1200px] px-5 py-20 sm:py-28 text-center">
      <a 
        href="#" 
        class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white/70 px-3 py-1 text-sm text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900/70 dark:text-zinc-400"
      >
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        Data refreshed today · {tools.length} tools
        <Icon name="arrow-right" size={14} />
      </a>
      
      <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-semibold tracking-tight text-zinc-900 sm:text-6xl dark:text-white">
        DevXTools: the developer's guide to <span class="bg-gradient-to-r from-indigo-500 to-violet-500 bg-clip-text text-transparent">API development</span> &amp; testing tools
      </h1>
      
      <p class="mx-auto mt-5 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
        Independent, neutral comparisons of tools for API development, mocking, testing, and test data generation.
      </p>
      
      <button 
        id="hero-search"
        class="mx-auto mt-9 flex w-full max-w-xl items-center gap-3 rounded-xl border border-zinc-300 bg-white px-4 py-3.5 text-left text-zinc-500 shadow-lg shadow-indigo-500/5 hover:border-indigo-400 dark:border-zinc-700 dark:bg-zinc-900"
      >
        <Icon name="search" size={20} />
        <span>Search tools, e.g. "OpenAPI mock server"</span>
        <kbd class="ml-auto hidden sm:inline rounded border border-zinc-300 px-1.5 text-xs font-mono dark:border-zinc-700">⌘K</kbd>
      </button>
      
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a 
          href="/catalog/" 
          class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-5 py-2.5 font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900"
        >
          <Icon name="layout-grid" size={16} />
          Browse catalog
        </a>
        <a 
          href="/picker/" 
          class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-5 py-2.5 font-medium text-zinc-900 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-white"
        >
          <Icon name="sparkles" size={16} class="text-indigo-500" />
          Pick a tool for me
        </a>
      </div>
      
      <dl class="mx-auto mt-14 grid max-w-lg grid-cols-3 gap-4">
        <div>
          <dt class="text-sm text-zinc-500">Tools</dt>
          <dd class="text-2xl font-semibold text-zinc-900 dark:text-white">{tools.length}</dd>
        </div>
        <div>
          <dt class="text-sm text-zinc-500">Categories</dt>
          <dd class="text-2xl font-semibold text-zinc-900 dark:text-white">{categories.length}</dd>
        </div>
        <div>
          <dt class="text-sm text-zinc-500">Open source</dt>
          <dd class="text-2xl font-semibold text-zinc-900 dark:text-white">{openSourcePercentage}%</dd>
        </div>
      </dl>
    </div>
  </section>

  <main class="mx-auto max-w-[1200px] px-5">
    <section class="pt-20">
      <StackPickerWidget />
    </section>

    <section class="pt-10">
      <PollCard id="home-poll-card" />
    </section>
    
    <section class="pt-20">
      <div class="flex items-end justify-between">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-white">Browse by section</h2>
          <p class="mt-1 text-zinc-600 dark:text-zinc-400">Explore tools organized by development workflow.</p>
        </div>
        <a 
          href="/catalog/" 
          class="hidden sm:inline-flex items-center gap-1 text-sm font-medium text-indigo-600 dark:text-indigo-400"
        >
          All tools
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a 
          href="/demos/"
          class="group rounded-xl border border-indigo-200 bg-indigo-50 p-6 hover:border-indigo-400 hover:shadow-md transition dark:border-indigo-900/50 dark:bg-indigo-950/40 dark:hover:border-indigo-500/60"
        >
          <span class="grid h-12 w-12 place-items-center rounded-lg bg-indigo-100 text-indigo-600 dark:bg-indigo-500/20 dark:text-indigo-400">
            <Icon name="play" size={24} />
          </span>
          <div class="mt-4 text-xl font-semibold text-zinc-900 dark:text-white">Try it live</div>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">Run demos in your browser with no install required.</p>
          <div class="mt-4 text-sm font-medium text-indigo-600 dark:text-indigo-400">
            See demos →
          </div>
        </a>
        
        <a 
          href="/mocking-test-data/"
          class="group rounded-xl border border-zinc-200 p-6 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800 dark:hover:border-indigo-500/60"
        >
          <span class="grid h-12 w-12 place-items-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
            <Icon name="flask-conical" size={24} />
          </span>
          <div class="mt-4 text-xl font-semibold text-zinc-900 dark:text-white">Mocking & Test Data</div>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">HTTP mocking, mock servers, contract testing, and test data generation.</p>
          <div class="mt-4 text-sm font-medium text-indigo-600 dark:text-indigo-400">
            {tools.filter(t => t.sections.includes('mocking-test-data')).length} tools →
          </div>
        </a>
        
        <a 
          href="/api-development/"
          class="group rounded-xl border border-zinc-200 p-6 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800 dark:hover:border-indigo-500/60"
        >
          <span class="grid h-12 w-12 place-items-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
            <Icon name="code" size={24} />
          </span>
          <div class="mt-4 text-xl font-semibold text-zinc-900 dark:text-white">API Development</div>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">API clients, OpenAPI tooling, and SDK generation for API-first development.</p>
          <div class="mt-4 text-sm font-medium text-indigo-600 dark:text-indigo-400">
            {tools.filter(t => t.sections.includes('api-development')).length} tools →
          </div>
        </a>
        
        <a 
          href="/testing/"
          class="group rounded-xl border border-zinc-200 p-6 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800 dark:hover:border-indigo-500/60"
        >
          <span class="grid h-12 w-12 place-items-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
            <Icon name="bug" size={24} />
          </span>
          <div class="mt-4 text-xl font-semibold text-zinc-900 dark:text-white">Testing</div>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">End-to-end testing and load testing for web and mobile applications.</p>
          <div class="mt-4 text-sm font-medium text-indigo-600 dark:text-indigo-400">
            {tools.filter(t => t.sections.includes('testing')).length} tools →
          </div>
        </a>
        
        <a 
          href="/observability/"
          class="group rounded-xl border border-zinc-200 p-6 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800 dark:hover:border-indigo-500/60"
        >
          <span class="grid h-12 w-12 place-items-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
            <Icon name="eye" size={24} />
          </span>
          <div class="mt-4 text-xl font-semibold text-zinc-900 dark:text-white">Observability & Logging</div>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">Error monitoring, distributed tracing, log aggregation, and network debugging.</p>
          <div class="mt-4 text-sm font-medium text-indigo-600 dark:text-indigo-400">
            {tools.filter(t => t.sections.includes('observability')).length} tools →
          </div>
        </a>
      </div>
    </section>

    <section class="pt-20">
      <div class="flex items-end justify-between">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-white">Popular tools</h2>
          <p class="mt-1 text-zinc-600 dark:text-zinc-400">Most-starred on GitHub · data fetched 2026-10-14.</p>
        </div>
        <a 
          href="/catalog/" 
          class="inline-flex items-center gap-1 text-sm font-medium text-indigo-600 dark:text-indigo-400"
        >
          View all {tools.length}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {popularTools.map(tool => (
          <a 
            href={`/tools/${tool.slug}/`}
            class="flex flex-col rounded-xl border border-zinc-200 p-5 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
          >
            <div class="flex items-center gap-3">
              <ToolLogo tool={tool} />
              <div class="flex-1">
                <div class="font-semibold text-zinc-900 dark:text-white">{tool.name}</div>
                <div class="text-sm text-zinc-500">{CATEGORY_LABELS[tool.categories[0]]}</div>
              </div>
              {tool.githubStars && (
                <span class="flex items-center gap-1 text-sm text-zinc-500">
                  <Icon name="star" size={16} />
                  {tool.githubStars >= 1000 
                    ? `${(tool.githubStars / 1000).toFixed(1).replace(/\.0$/, '')}k` 
                    : tool.githubStars.toLocaleString()}
                </span>
              )}
            </div>
            <p class="mt-3 line-clamp-2 text-[15px] text-zinc-600 dark:text-zinc-400">
              {tool.description}
            </p>
            <div class="mt-4">
              {tool.license && (
                <span class={`inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-medium ${getLicenseBadgeClass(tool.license)}`}>
                  {tool.license}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="pt-20 pb-20">
      <div class="flex items-end justify-between">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-white">Latest guides</h2>
          <p class="mt-1 text-zinc-600 dark:text-zinc-400">Hands-on tutorials and honest comparisons.</p>
        </div>
        <a 
          href="/guides/" 
          class="inline-flex items-center gap-1 text-sm font-medium text-indigo-600 dark:text-indigo-400"
        >
          All guides
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {guides.map(guide => (
          <a 
            href={guide.url}
            class="rounded-xl border border-zinc-200 p-5 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
          >
            <span class="text-xs font-semibold uppercase tracking-wide text-indigo-600 dark:text-indigo-400">
              {guide.category}
            </span>
            <h3 class="mt-2 text-lg font-semibold text-zinc-900 dark:text-white">
              {guide.title}
            </h3>
            <p class="mt-2 text-[15px] text-zinc-600 dark:text-zinc-400">
              {guide.description}
            </p>
            <div class="mt-4 flex items-center gap-1.5 text-sm text-zinc-500">
              <Icon name="wrench" size={16} />
              {guide.tools}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <script>
    document.getElementById('hero-search')?.addEventListener('click', () => {
      document.getElementById('search-button')?.click();
    });
  </script>
</Layout>

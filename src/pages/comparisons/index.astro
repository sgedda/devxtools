---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Comparisons" 
  description="Side-by-side comparisons of popular API mocking and test data tools."
>
  <div class="container">
    <h1>Tool Comparisons</h1>
    <p class="subtitle">
      Side-by-side comparisons to help you choose the right tool for your needs.
    </p>
    
    <div class="comparison-list">
      <a href="/comparisons/msw-vs-nock/" class="comparison-card">
        <h2>MSW vs Nock</h2>
        <p>The two most popular HTTP mocking libraries for JavaScript compared head-to-head.</p>
        <div class="tools">
          <span class="badge">MSW</span>
          <span class="badge">Nock</span>
        </div>
      </a>
      
      <a href="/comparisons/msw-vs-nock-vs-polly/" class="comparison-card">
        <h2>MSW vs Nock vs Polly.js</h2>
        <p>Three-way comparison including Polly.js for record/replay workflows.</p>
        <div class="tools">
          <span class="badge">MSW</span>
          <span class="badge">Nock</span>
          <span class="badge">Polly.js</span>
        </div>
      </a>
      
      <div class="comparison-card coming-soon">
        <h2>WireMock vs Mountebank</h2>
        <p>JVM and Node.js mock servers compared.</p>
        <span class="coming-soon-badge">Coming Soon</span>
      </div>
      
      <div class="comparison-card coming-soon">
        <h2>Faker vs Chance vs Mockaroo</h2>
        <p>Test data generation tools compared.</p>
        <span class="coming-soon-badge">Coming Soon</span>
      </div>
    </div>
  </div>
</Layout>

<style>
  .subtitle {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
  
  .comparison-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .comparison-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2rem;
    text-decoration: none;
    transition: all 0.2s;
    display: block;
  }
  
  .comparison-card:not(.coming-soon):hover {
    border-color: var(--accent);
    transform: translateX(4px);
  }
  
  .comparison-card.coming-soon {
    opacity: 0.6;
    cursor: default;
  }
  
  .comparison-card h2 {
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  
  .comparison-card p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  
  .tools {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .coming-soon-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--warning);
    color: var(--bg);
    border-radius: 12px;
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>

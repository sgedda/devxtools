              <td>Git</td>
              <td>Shared workspaces (multi-user needs the Team plan)</td>
            </tr>
            <tr>
              <td>SSO / SCIM</td>
              <td>Ultimate</td>
              <td>SSO via a $6/user/month add-on on Team; SCIM on Enterprise</td>
            </tr>

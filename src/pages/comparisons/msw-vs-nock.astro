    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  pre {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;

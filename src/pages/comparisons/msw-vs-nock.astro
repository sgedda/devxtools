    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 3rem;
  }
  
  .intro p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.8;
  }
  
  section {
    margin-bottom: 3rem;
  }
  
  .quick-comparison {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2rem;
  }
  
  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.5rem;
  }
  
  .comparison-col h3 {
    margin-top: 0;
    margin-bottom: 1rem;
    color: var(--accent);
  }
  
  .comparison-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .comparison-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  
  .comparison-list li:last-child {
    border-bottom: none;
  }
  
  .recommendation-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 1.5rem;
  }
  
  .recommendation-card h3 {
    margin-top: 0;
    margin-bottom: 1rem;
    color: var(--accent);
  }
  
  .recommendation-card ul {
    margin: 0 0 1rem 1.5rem;
  }
  
  .recommendation-card li {
    margin-bottom: 0.5rem;
  }
  
  .recommendation-note {
    margin: 0;
    padding: 1rem;
    background: var(--bg);
    border-radius: 6px;
    color: var(--text-secondary);
  }
  
  .code-comparison {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2rem;
    min-width: 0;
  }
  
  .code-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
    min-width: 0;
  }
  
  .code-block {
    min-width: 0;
  }
  

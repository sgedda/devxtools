---
import Layout from '../../layouts/Layout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import Code from '../../components/Code.astro';
import ReportError from '../../components/ReportError.astro';
import RunIt from '../../components/RunIt.astro';
import { getToolBySlug } from '../../lib/tools';

const msw = getToolBySlug('msw');
const nock = getToolBySlug('nock');
const polly = getToolBySlug('pollyjs');

const published = "2026-10-14";
const updated = "2026-10-14";
const tldr = "MSW excels for full-stack web apps with browser and Node.js support, using Service Workers for network-level interception. Nock is simpler and lighter, ideal for Node.js-only backend testing with built-in record/replay, but lacks browser support.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "headline": "MSW vs Nock (2026): Differences, Code & When to Use Each",
      "description": "Compare MSW and Nock, the two most popular HTTP mocking libraries for JavaScript and TypeScript.",
      "url": "https://devxtools.dev/comparisons/msw-vs-nock/",
      "datePublished": published,
      "dateModified": updated,
      "author": {
        "@type": "Organization",
        "name": "DevX Tools"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://devxtools.dev/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Comparisons",
          "item": "https://devxtools.dev/comparisons/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "MSW vs Nock",
          "item": "https://devxtools.dev/comparisons/msw-vs-nock/"
        }
      ]
    }
  ]
};
---

<Layout 
  title="MSW vs Nock (2026): Differences, Code & When to Use Each" 
  description="Compare MSW and Nock, the two most popular HTTP mocking libraries for JavaScript and TypeScript."
  jsonLd={jsonLd}
>
  <div class="container mx-auto max-w-4xl px-5">
    <article class="comparison">
      <header>
        <h1>MSW vs Nock</h1>
        <p class="subtitle">Choosing between the two most popular HTTP mocking libraries</p>
        <p class="meta">Last updated: {new Date(updated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</p>
      </header>
      
      <div class="dx-prose">
      <section class="tldr">
        <h2>TL;DR</h2>
        <p>{tldr}</p>
      </section>
      
      <section class="intro">
        <p>
          When you need to mock HTTP requests in JavaScript or TypeScript tests, two tools dominate: 
          <strong>MSW (Mock Service Worker)</strong> and <strong>Nock</strong>. Both are mature, 
          well-maintained, and widely adopted, but they take fundamentally different approaches to interception.
        </p>
      </section>
      
      <section class="quick-comparison">
        <h2>At a Glance</h2>
        <div class="comparison-grid">
          <div class="comparison-col">
            <h3>MSW</h3>
            <ul class="comparison-list">
              <li>✅ Works in browser <em>and</em> Node.js</li>
              <li>✅ Network-level interception (Service Worker)</li>
              <li>✅ Same API everywhere</li>
              <li>✅ Great for full-stack apps</li>
              <li>❌ Slightly more setup</li>
              <li>❌ No built-in recording</li>
            </ul>
          </div>
          
          <div class="comparison-col">
            <h3>Nock</h3>
            <ul class="comparison-list">
              <li>✅ Dead simple API</li>
              <li>✅ Built-in record/replay</li>
              <li>✅ Powerful request matching</li>
              <li>✅ Battle-tested since 2011</li>
              <li>❌ Node.js only</li>
              <li>❌ Patches HTTP module</li>
            </ul>
          </div>
        </div>
      </section>
      
      <section class="when-to-use">
        <h2>Which Should You Choose?</h2>
        
        <div class="recommendation-card primary">
          <h3>Choose MSW if...</h3>
          <ul>
            <li>You're building a React, Vue, or Angular app with browser tests</li>
            <li>You want the same mocking code in both browser and Node.js</li>
            <li>You prefer network-level interception over module patching</li>
            <li>You want to use mocks in development, not just tests</li>
          </ul>
          <p class="recommendation-note">
            <strong>Best for:</strong> Modern web applications with component + integration tests
          </p>
        </div>
        
        <div class="recommendation-card primary">
          <h3>Choose Nock if...</h3>
          <ul>
            <li>You're only testing Node.js code (backend services, APIs)</li>
            <li>You want the absolute simplest API possible</li>
            <li>You need to record real API calls and replay them</li>
            <li>You don't need browser support</li>
          </ul>
          <p class="recommendation-note">
            <strong>Best for:</strong> Backend Node.js services and APIs
          </p>
        </div>
      </section>
      
      <section class="code-comparison">
        <h2>Side-by-Side Code Example</h2>
        
        <div class="code-grid">
          <div class="code-block">
            <h4>MSW</h4>
            <Code 
              code={`import { http, HttpResponse } from 'msw'
import { setupServer } from 'msw/node'

const server = setupServer(
  http.get('/api/user', () => {
    return HttpResponse.json({
      id: 1,
      name: 'John Doe'
    })
  })
)

beforeAll(() => server.listen())
afterEach(() => server.resetHandlers())
afterAll(() => server.close())`}
              lang="ts"
            />
          </div>
          
          <div class="code-block">
            <h4>Nock</h4>
            <Code 
              code={`import nock from 'nock'

nock('https://api.example.com')
  .get('/api/user')
  .reply(200, {
    id: 1,
    name: 'John Doe'
  })

// That's it! Nock intercepts 
// matching requests automatically`}
              lang="ts"
            />
          </div>
        </div>

        <RunIt project="msw-vitest" file="api.test.js" title="Try MSW + Vitest Live" />
        <p class="demo-caption">Run this MSW test example in your browser with StackBlitz (a third-party service).</p>
      </section>
      
      <section class="detailed-comparison">
        <h2>Detailed Comparison</h2>
        
        <div class="dx-table" style="--cols:3">
          <div class="dx-table__scroll" role="region" tabindex="0" aria-label="Comparison table">
          <table>
            <thead>
              <tr>
                <th>Feature</th>
                <th>MSW</th>
                <th>Nock</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Browser Support</td>
                <td class="check">✅ Yes</td>
                <td class="cross">❌ No</td>
              </tr>
              <tr>
                <td>Node.js Support</td>
                <td class="check">✅ Yes</td>
                <td class="check">✅ Yes</td>
              </tr>
              <tr>
                <td>Interception Method</td>
                <td>Service Worker / Native modules</td>
                <td>Patches Node.js HTTP module</td>
              </tr>
              <tr>
                <td>Record/Replay</td>
                <td class="cross">❌ No</td>
                <td class="check">✅ Yes</td>
              </tr>
              <tr>
                <td>TypeScript Support</td>
                <td class="check">✅ Native</td>
                <td class="check">✅ Yes (types included)</td>
              </tr>
              <tr>
                <td>Learning Curve</td>
                <td>Medium</td>
                <td>Low</td>
              </tr>
              <tr>
                <td>GitHub Stars</td>
                <td>16k+</td>
                <td>12k+</td>
              </tr>
              <tr>
                <td>First Released</td>
                <td>2018</td>
                <td>2011</td>
              </tr>
            </tbody>
          </table>
          </div>
        </div>
        <p class="dx-table__hint" aria-hidden="true">Swipe the table left to see all columns.</p>
      </section>
      
      <section class="also-consider">
        <h2>Also Consider: Polly.js</h2>
        <p>
          If you need <strong>record/replay</strong> functionality with <strong>browser support</strong>, 
          check out <a href="/tools/pollyjs/">Polly.js</a>. Built by Netflix, it works in both 
          environments and specializes in recording real API traffic. It's more complex to set up 
          than MSW or Nock, but fills a unique niche.
        </p>
        <p>
          <a href="/comparisons/msw-vs-nock-vs-polly/" class="button button-secondary">
            See Full Three-Way Comparison →
          </a>
        </p>
      </section>
      </div>
      
      <ReportError 
        pageTitle="MSW vs Nock"
        pageUrl="https://devxtools.dev/comparisons/msw-vs-nock/"
      />
      
      <NewsletterSignup variant="article" />
      
      <footer class="comparison-footer">
        <p>
          <strong>Related:</strong> 
          <a href="/tools/msw/">MSW</a> • 
          <a href="/tools/nock/">Nock</a> • 
          <a href="/tools/pollyjs/">Polly.js</a>
        </p>
        <a href="/comparisons/" class="button">← Back to Comparisons</a>
      </footer>
    </article>
  </div>
</Layout>

<style>
  .comparison {
    min-width: 0;
  }
  
  header {
    margin-bottom: 2rem;
  }
  
  .subtitle {
    color: var(--text-secondary);
    font-size: 1.25rem;
    margin-top: 0.5rem;
  }
  
  .meta {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }
  
  .tldr {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .tldr h2 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
    color: var(--accent);
  }
  
  .tldr p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
  }
  

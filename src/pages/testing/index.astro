---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import { getToolsBySection } from '../../lib/tools';
import { CATEGORY_LABELS, SECTION_TO_CATEGORIES } from '../../lib/schema';
import { formatTimeAgo, getLicenseBadgeClass, CATEGORY_ICONS } from '../../lib/ui-helpers';

const tools = getToolsBySection('testing');
const sectionCategories = SECTION_TO_CATEGORIES['testing'];

const categoryCount = Object.fromEntries(
  sectionCategories.map(cat => [
    cat,
    tools.filter(t => t.categories.includes(cat)).length
  ])
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "API Testing Tools Compared (2026)",
  "description": "Compare E2E, API, mobile, and load testing tools for JavaScript, TypeScript, and React Native apps.",
  "url": "https://devxtools.dev/testing/",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": tools.map((tool, index) => ({
      "@type": "SoftwareApplication",
      "position": index + 1,
      "name": tool.name,
      "url": `https://devxtools.dev/tools/${tool.slug}/`,
      "description": tool.description,
      "applicationCategory": "DeveloperApplication"
    }))
  }
};
---

<Layout 
  title="API Testing Tools Compared (2026) | DevX Tools" 
  description="Compare E2E, API, mobile, and load testing tools for JavaScript, TypeScript, and React Native apps."
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-[1200px] px-5 pt-10">
    <nav class="text-sm text-zinc-500">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white">Home</a>
      /
      <span class="text-zinc-900 dark:text-white">Testing</span>
    </nav>
    
    <div class="mt-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
        <Icon name="bug" size={16} />
        Testing
      </div>
      
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-zinc-900 dark:text-white">API Testing Tools, Plus E2E, Mobile & Load Testing</h1>
      
      <p class="mt-3 max-w-3xl text-lg text-zinc-600 dark:text-zinc-400">
        Choosing among API testing tools, E2E frameworks and load testers starts with choosing the <strong>layer</strong> you're testing. Each layer has a different best tool, and most teams need more than one.
      </p>
      <ul class="mt-4 max-w-3xl space-y-2 text-zinc-600 dark:text-zinc-400">
        <li><strong>API testing.</strong> Run request collections with assertions from a CLI in CI: the Postman CLI or Newman for <a href="/tools/postman/" class="text-indigo-600 dark:text-indigo-400">Postman</a>, <code>bru run</code> for <a href="/tools/bruno/" class="text-indigo-600 dark:text-indigo-400">Bruno</a>, <code>hopp test</code> for <a href="/tools/hoppscotch/" class="text-indigo-600 dark:text-indigo-400">Hoppscotch</a> and Inso for <a href="/tools/insomnia/" class="text-indigo-600 dark:text-indigo-400">Insomnia</a>. Code-first teams can also call APIs directly from Playwright's <code>request</code> fixture. Compare the clients in <a href="/api-development/postman-alternatives/" class="text-indigo-600 dark:text-indigo-400">Postman alternatives</a>.</li>
        <li><strong>Browser E2E.</strong> <a href="/tools/playwright/" class="text-indigo-600 dark:text-indigo-400">Playwright</a> (Apache-2.0) drives Chromium, Firefox and WebKit from JS/TS, Python, Java or .NET. <a href="/tools/cypress/" class="text-indigo-600 dark:text-indigo-400">Cypress</a> (MIT) runs your tests inside the browser and has an interactive, time-travel debugger. Both can intercept and mock network requests (<code>page.route()</code> and <code>cy.intercept()</code>), which often matters more than raw speed.</li>
        <li><strong>Mobile.</strong> <a href="/tools/detox/" class="text-indigo-600 dark:text-indigo-400">Detox</a> is a gray-box framework built for React Native, with tests written in JavaScript. <a href="/tools/maestro/" class="text-indigo-600 dark:text-indigo-400">Maestro</a> describes flows in YAML for Android, iOS and web. <a href="/tools/appium/" class="text-indigo-600 dark:text-indigo-400">Appium</a> uses the W3C WebDriver protocol to automate native, hybrid and mobile-web apps from many languages.</li>
        <li><strong>Load and performance.</strong> <a href="/tools/k6/" class="text-indigo-600 dark:text-indigo-400">k6</a> (AGPL-3.0) is written in Go and scripted in JavaScript. <a href="/tools/locust/" class="text-indigo-600 dark:text-indigo-400">Locust</a> uses plain Python. <a href="/tools/gatling/" class="text-indigo-600 dark:text-indigo-400">Gatling</a> supports Java, Kotlin, Scala and, more recently, JS/TS. <a href="/tools/artillery/" class="text-indigo-600 dark:text-indigo-400">Artillery</a> uses YAML or Node scenarios and can drive Playwright for browser-level load.</li>
      </ul>
      <p class="mt-4 max-w-3xl text-zinc-600 dark:text-zinc-400">
        Need to fake the backend instead? See the <a href="/mocking-test-data/" class="text-indigo-600 dark:text-indigo-400">mocking section</a>.
      </p>
      <p class="mt-4 max-w-3xl text-sm text-zinc-500 dark:text-zinc-500">
        Every tool page lists licence, language and the date we last checked it. For a guided choice, try the <a href="/picker/" class="text-indigo-600 dark:text-indigo-400">tool picker</a>.
      </p>
    </div>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Top comparisons and guides</h2>
      <ul class="mt-4 space-y-2">
        <li><a href="/comparisons/playwright-vs-cypress/" class="text-indigo-600 dark:text-indigo-400 hover:underline">Playwright vs Cypress (2026)</a>: architecture, network mocking, CI cost and a migration map</li>
        <li><a href="/guides/mock-api-playwright/" class="text-indigo-600 dark:text-indigo-400 hover:underline">How to mock APIs in Playwright</a>: <code>page.route</code>, HAR replay and MSW, tested on 1.64.1</li>
        <li><a href="/comparisons/" class="text-indigo-600 dark:text-indigo-400 hover:underline">All comparisons</a></li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Tools in this section</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map(tool => (
          <a 
            href={`/tools/${tool.slug}/`}
            class="group rounded-xl border border-zinc-200 p-4 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
          >
            <div class="flex items-start gap-3">
              <ToolLogo tool={tool} size="sm" />
              <div class="flex-1 min-w-0">
                <div class="font-medium text-zinc-900 dark:text-white">{tool.name}</div>
                <div class="text-sm text-zinc-500 mt-0.5">{CATEGORY_LABELS[tool.categories[0]]}</div>
                {tool.affiliation && (
                  <div class="text-xs text-amber-700 dark:text-amber-400 mt-1">
                    ⚠️ {tool.affiliation}
                  </div>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12 pb-20">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Browse by category</h2>
      <div class="mt-6 grid gap-3 grid-cols-2">
        {sectionCategories.map(cat => (
          <a 
            href={`/catalog/?category=${cat}`}
            class="group rounded-xl border border-zinc-200 p-4 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
          >
            <span class="grid h-9 w-9 place-items-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
              <Icon name={CATEGORY_ICONS[cat]} size={20} />
            </span>
            <div class="mt-3 font-medium text-zinc-900 dark:text-white">{CATEGORY_LABELS[cat]}</div>
            <div class="text-sm text-zinc-500">{categoryCount[cat]} tools</div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

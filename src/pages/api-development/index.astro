---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import { getToolsBySection } from '../../lib/tools';
import { CATEGORY_LABELS, SECTION_TO_CATEGORIES } from '../../lib/schema';
import { formatTimeAgo, getLicenseBadgeClass, CATEGORY_ICONS } from '../../lib/ui-helpers';

const tools = getToolsBySection('api-development');
const sectionCategories = SECTION_TO_CATEGORIES['api-development'];

const categoryCount = Object.fromEntries(
  sectionCategories.map(cat => [
    cat,
    tools.filter(t => t.categories.includes(cat)).length
  ])
);
---

<Layout 
  title="API Development Tools" 
  description="Comprehensive guide to API clients, OpenAPI tooling, and SDK generators for API-first development."
>
  <main class="mx-auto max-w-[1200px] px-5 pt-10">
    <nav class="text-sm text-zinc-500">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white">Home</a>
      /
      <span class="text-zinc-900 dark:text-white">API Development</span>
    </nav>
    
    <div class="mt-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
        <Icon name="code" size={16} />
        API Development
      </div>
      
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-zinc-900 dark:text-white">API Development Tools</h1>
      <p class="mt-3 max-w-3xl text-lg text-zinc-600 dark:text-zinc-400">
        Building an API involves four jobs: <strong>designing</strong> the contract, <strong>checking</strong> it, <strong>calling</strong> it while you build, and <strong>shipping</strong> it to consumers as docs and SDKs. This section covers the tools JS/TS teams use for each, with trade-offs stated plainly.
      </p>
      <ul class="mt-4 max-w-3xl space-y-2 text-zinc-600 dark:text-zinc-400">
        <li><strong>Design and lint.</strong> Write OpenAPI by hand or visually with <a href="/tools/swagger-editor/" class="text-indigo-600 dark:text-indigo-400">Swagger Editor</a>, <a href="/tools/stoplight/" class="text-indigo-600 dark:text-indigo-400">Stoplight</a> or <a href="/tools/redocly/" class="text-indigo-600 dark:text-indigo-400">Redocly</a>, then enforce a style guide in CI with <a href="/tools/spectral/" class="text-indigo-600 dark:text-indigo-400">Spectral</a>.</li>
        <li><strong>Call and debug.</strong> API clients range from cloud platforms (<a href="/tools/postman/" class="text-indigo-600 dark:text-indigo-400">Postman</a>) to Git-friendly local apps (<a href="/tools/bruno/" class="text-indigo-600 dark:text-indigo-400">Bruno</a>, <a href="/tools/insomnia/" class="text-indigo-600 dark:text-indigo-400">Insomnia</a>), browser-based or self-hosted tools (<a href="/tools/hoppscotch/" class="text-indigo-600 dark:text-indigo-400">Hoppscotch</a>) and the terminal (<a href="/tools/httpie/" class="text-indigo-600 dark:text-indigo-400">HTTPie</a>). The real differences are where your collections live, whether you need an account, and which CLI runs them in CI.</li>
        <li><strong>Docs and SDKs.</strong> Generate client libraries from the spec with <a href="/tools/openapi-generator/" class="text-indigo-600 dark:text-indigo-400">OpenAPI Generator</a> (open source) or hosted generators such as <a href="/tools/speakeasy/" class="text-indigo-600 dark:text-indigo-400">Speakeasy</a>, <a href="/tools/stainless/" class="text-indigo-600 dark:text-indigo-400">Stainless</a> and <a href="/tools/fern/" class="text-indigo-600 dark:text-indigo-400">Fern</a>.</li>
      </ul>
      <p class="mt-4 max-w-3xl text-sm text-zinc-500 dark:text-zinc-500">
        Every tool page lists the licence, pricing model and last-checked date. Prices change often, so we date them. Not sure where to start? Try the <a href="/picker/" class="text-indigo-600 dark:text-indigo-400">tool picker</a>.
      </p>
    </div>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Top comparisons</h2>
      <ul class="mt-4 space-y-2">
        <li><a href="/api-development/postman-alternatives/" class="text-indigo-600 dark:text-indigo-400 hover:underline">Best Postman alternatives (2026)</a>: Bruno, Hoppscotch, Insomnia, HTTPie, Yaak and more, grouped by the job Postman did for you</li>
        <li><a href="/comparisons/bruno-vs-postman/" class="text-indigo-600 dark:text-indigo-400 hover:underline">Bruno vs Postman</a>: files in Git vs a cloud platform, CI runners, pricing</li>
        <li><a href="/comparisons/" class="text-indigo-600 dark:text-indigo-400 hover:underline">All comparisons</a></li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Categories</h2>
      <div class="mt-6 grid gap-3 grid-cols-2 md:grid-cols-3">
        {sectionCategories.map(cat => (
          <a 
            href={`/catalog/?category=${cat}`}
            class="group rounded-xl border border-zinc-200 p-4 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
          >
            <span class="grid h-9 w-9 place-items-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
              <Icon name={CATEGORY_ICONS[cat]} size={20} />
            </span>
            <div class="mt-3 font-medium text-zinc-900 dark:text-white">{CATEGORY_LABELS[cat]}</div>
            <div class="text-sm text-zinc-500">{categoryCount[cat]} tools</div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-16 pb-20">
      <div class="flex items-end justify-between">
        <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">All tools in this section</h2>
        <a 
          href="/catalog/?section=api-development" 
          class="text-sm font-medium text-indigo-600 dark:text-indigo-400"
        >
          Filter in catalog →
        </a>
      </div>
      
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map(tool => (
          <a 
            href={`/tools/${tool.slug}/`}
            class="flex flex-col rounded-xl border border-zinc-200 p-5 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
          >
            <div class="flex items-center gap-3">
              <ToolLogo tool={tool} />
              <div class="flex-1">
                <div class="font-semibold text-zinc-900 dark:text-white">{tool.name}</div>
                <div class="text-sm text-zinc-500">{CATEGORY_LABELS[tool.categories[0]]}</div>
              </div>
              {tool.githubStars && (
                <span class="flex items-center gap-1 text-sm text-zinc-500">
                  <Icon name="star" size={16} />
                  {tool.githubStars >= 1000 
                    ? `${(tool.githubStars / 1000).toFixed(1).replace(/\.0$/, '')}k` 
                    : tool.githubStars.toLocaleString()}
                </span>
              )}
            </div>
            <p class="mt-3 line-clamp-2 text-[15px] text-zinc-600 dark:text-zinc-400">
              {tool.description}
            </p>
            {tool.affiliation && (
              <p class="mt-2 text-xs text-amber-700 dark:text-amber-400">
                ⚠️ {tool.affiliation}
              </p>
            )}
            <div class="mt-4">
              {tool.license && (
                <span class={`inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-medium ${getLicenseBadgeClass(tool.license)}`}>
                  {tool.license}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

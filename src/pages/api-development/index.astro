---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import { getToolsBySection } from '../../lib/tools';
import { CATEGORY_LABELS, SECTION_TO_CATEGORIES } from '../../lib/schema';
import { formatTimeAgo, getLicenseBadgeClass, CATEGORY_ICONS } from '../../lib/ui-helpers';

const tools = getToolsBySection('api-development');
const sectionCategories = SECTION_TO_CATEGORIES['api-development'];

const categoryCount = Object.fromEntries(
  sectionCategories.map(cat => [
    cat,
    tools.filter(t => t.categories.includes(cat)).length
  ])
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "API Development Tools Compared (2026)",
  "description": "Compare API clients, OpenAPI editors and linters, and SDK generators for TypeScript and JavaScript teams.",
  "url": "https://devxtools.dev/api-development/",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": tools.map((tool, index) => ({
      "@type": "SoftwareApplication",
      "position": index + 1,
      "name": tool.name,
      "url": `https://devxtools.dev/tools/${tool.slug}/`,
      "description": tool.description,
      "applicationCategory": "DeveloperApplication"
    }))
  }
};
---

<Layout 
  title="API Development Tools Compared (2026) | DevX Tools" 
  description="Compare API clients, OpenAPI editors and linters, and SDK generators for TypeScript and JavaScript teams."
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-[1200px] px-5 pt-10">
    <nav class="text-sm text-zinc-500">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white">Home</a>
      /
      <span class="text-zinc-900 dark:text-white">API Development</span>
    </nav>
    
    <div class="mt-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
        <Icon name="code" size={16} />
        API Development
      </div>
      
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-zinc-900 dark:text-white">API Development Tools Compared</h1>
      
      <div class="mt-4 max-w-3xl text-[16px] leading-7 text-zinc-600 dark:text-zinc-400 space-y-3">
        <p>
          Building and shipping APIs requires tools that span the entire lifecycle: from designing and documenting specs to calling endpoints, generating SDKs, and linting for consistency. This section covers the tools JavaScript and TypeScript teams rely on to work API-first.
        </p>
        <p>
          <strong>API clients</strong> like Postman, Insomnia, HTTPie, and Bruno let you test endpoints interactively, manage collections, and share requests across teams. They're essential for debugging and exploratory testing during development.
        </p>
        <p>
          <strong>OpenAPI tooling</strong> includes editors like Stoplight Studio and Swagger Editor for authoring specs, linters like Spectral and Redocly that enforce API design rules, and Prism for generating spec-driven mock servers. These tools help teams design APIs before implementation and keep docs in sync with code.
        </p>
        <p>
          <strong>SDK generators</strong> such as OpenAPI Generator, Speakeasy, Stainless, and Fern create type-safe client libraries from OpenAPI or custom specs, letting you ship SDKs to your users with minimal manual work. Trade-offs include code quality, customization depth, and whether generation happens at build time or via hosted platforms.
        </p>
      </div>
    </div>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Tools in this section</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map(tool => (
          <a 
            href={`/tools/${tool.slug}/`}
            class="group rounded-xl border border-zinc-200 p-4 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
          >
            <div class="flex items-start gap-3">
              <ToolLogo tool={tool} size="sm" />
              <div class="flex-1 min-w-0">
                <div class="font-medium text-zinc-900 dark:text-white">{tool.name}</div>
                <div class="text-sm text-zinc-500 mt-0.5">{CATEGORY_LABELS[tool.categories[0]]}</div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12 pb-20">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Browse by category</h2>
      <div class="mt-6 grid gap-3 grid-cols-2 md:grid-cols-3">
        {sectionCategories.map(cat => (
          <a 
            href={`/catalog/?category=${cat}`}
            class="group rounded-xl border border-zinc-200 p-4 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
          >
            <span class="grid h-9 w-9 place-items-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
              <Icon name={CATEGORY_ICONS[cat]} size={20} />
            </span>
            <div class="mt-3 font-medium text-zinc-900 dark:text-white">{CATEGORY_LABELS[cat]}</div>
            <div class="text-sm text-zinc-500">{categoryCount[cat]} tools</div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

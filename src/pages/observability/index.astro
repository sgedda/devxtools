---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import StackPickerWidget from '../../components/StackPickerWidget.astro';
import { getToolsBySection } from '../../lib/tools';
import { CATEGORY_LABELS, SECTION_TO_CATEGORIES } from '../../lib/schema';
import { formatTimeAgo, getLicenseBadgeClass, CATEGORY_ICONS } from '../../lib/ui-helpers';

const tools = getToolsBySection('observability');
const sectionCategories = SECTION_TO_CATEGORIES['observability'];

const categoryCount = Object.fromEntries(
  sectionCategories.map(cat => [
    cat,
    tools.filter(t => t.categories.includes(cat)).length
  ])
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Observability Tools for Developers Compared (2026)",
  "description": "Compare logging, tracing, error tracking, and network debugging tools for Node.js and React Native apps.",
  "url": "https://devxtools.dev/observability/",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": tools.map((tool, index) => ({
      "@type": "SoftwareApplication",
      "position": index + 1,
      "name": tool.name,
      "url": `https://devxtools.dev/tools/${tool.slug}/`,
      "description": tool.description,
      "applicationCategory": "DeveloperApplication"
    }))
  }
};
---

<Layout 
  title="Observability Tools for Developers Compared (2026) | DevX Tools" 
  description="Compare logging, tracing, error tracking, and network debugging tools for Node.js and React Native apps."
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-[1200px] px-5 pt-10">
    <nav class="text-sm text-zinc-500">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white">Home</a>
      <span aria-hidden="true"> / </span>
      <span class="text-zinc-900 dark:text-white">Observability & Logging</span>
    </nav>
    
    <div class="mt-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
        <Icon name="eye" size={16} />
        Observability & Logging
      </div>
      
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-zinc-900 dark:text-white">Observability Tools for Developers</h1>
      
      <div class="mt-4 max-w-3xl text-[16px] leading-7 text-zinc-600 dark:text-zinc-400 space-y-3">
        <p>
          Observability tools help you understand what's happening in production and development: where errors occur, how requests flow across services, what your app logs, and what network calls look like. This section covers logging, tracing, error tracking, and debugging tools for Node.js and React Native applications.
        </p>
        <p>
          <strong>Application logging</strong> libraries like pino and Winston structure logs for Node.js apps, with pino prioritizing speed and Winston offering more transports. Both serialize JSON and integrate with log aggregation platforms. Trade-off: pino is faster; Winston has more plugins and flexibility.
        </p>
        <p>
          <strong>Error monitoring</strong> platforms like Sentry and BetterStack capture exceptions, track user sessions, and surface performance issues in production. Sentry has deep JavaScript framework integrations (React, Vue, Next.js) and release tracking. BetterStack (formerly Logtail) combines logs and errors. Choose based on whether you want specialized error tracking (Sentry) or unified logs + errors (BetterStack).
        </p>
        <p>
          <strong>Distributed tracing</strong> via OpenTelemetry or Datadog connects requests across microservices, showing latency and dependencies. OpenTelemetry is vendor-neutral but requires more setup. Datadog is a full observability platform with built-in tracing, logs, and metrics. <strong>Network debugging</strong> tools like Proxyman, Charles, Flipper, and Reactotron inspect HTTP traffic during development, essential for React Native where browser DevTools don't work.
        </p>
      </div>
    </div>

    <section class="mt-12">
      <StackPickerWidget need="observe" />
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Tools in this section</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map(tool => (
          <a 
            href={`/tools/${tool.slug}/`}
            class="group rounded-xl border border-zinc-200 p-4 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
          >
            <div class="flex items-start gap-3">
              <ToolLogo tool={tool} size="sm" />
              <div class="flex-1 min-w-0">
                <div class="font-medium text-zinc-900 dark:text-white">{tool.name}</div>
                <div class="text-sm text-zinc-500 mt-0.5">{CATEGORY_LABELS[tool.categories[0]]}</div>
                {tool.affiliation && (
                  <div class="text-xs text-amber-700 dark:text-amber-400 mt-1">
                    ⚠️ {tool.affiliation}
                  </div>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12 pb-20">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Browse by category</h2>
      <div class="mt-6 grid gap-3 grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
        {sectionCategories.map(cat => (
          <a 
            href={`/catalog/?category=${cat}`}
            class="group rounded-xl border border-zinc-200 p-4 hover:border-indigo-400 hover:shadow-md transition dark:border-zinc-800"
          >
            <span class="grid h-9 w-9 place-items-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
              <Icon name={CATEGORY_ICONS[cat]} size={20} />
            </span>
            <div class="mt-3 font-medium text-zinc-900 dark:text-white">{CATEGORY_LABELS[cat]}</div>
            <div class="text-sm text-zinc-500">{categoryCount[cat]} tools</div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import RunIt from '../../components/RunIt.astro';
import Icon from '../../components/Icon.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "headline": "Live Demos",
      "description": "Run interactive demos of API mocking and testing tools directly in your browser via StackBlitz.",
      "url": "https://devxtools.dev/demos/",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://devxtools.dev/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Demos",
            "item": "https://devxtools.dev/demos/"
          }
        ]
      }
    }
  ]
};
---

<Layout 
  title="Live Demos" 
  description="Run interactive demos of API mocking and testing tools directly in your browser via StackBlitz."
  jsonLd={jsonLd}
>
  <div class="container mx-auto max-w-[900px] px-5 py-12">
    <article>
      <header class="mb-10">
        <h1 class="text-4xl font-semibold tracking-tight text-zinc-900 dark:text-white mb-4">Live demos</h1>
        <p class="text-lg text-zinc-600 dark:text-zinc-400">
          Try the tools directly in your browser. These demos run in StackBlitz (a third-party service) — nothing is installed on your computer.
        </p>
      </header>

      <section class="mb-12">
        <h2 class="text-2xl font-semibold text-zinc-900 dark:text-white mb-6">Interactive demos</h2>
        
        <div class="space-y-6">
          <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 p-6 bg-zinc-50 dark:bg-zinc-900/40">
            <h3 class="text-xl font-semibold text-zinc-900 dark:text-white mb-2">MSW + Vitest</h3>
            <p class="text-zinc-600 dark:text-zinc-400 mb-4">
              See how Mock Service Worker intercepts API calls in a Vitest test suite, returning fake data without hitting real endpoints.
            </p>
            <RunIt project="msw-vitest" file="api.test.js" title="Try MSW + Vitest Live" />
            <p class="mt-3 text-sm text-zinc-500">
              <a href="/comparisons/msw-vs-nock/" class="text-indigo-600 dark:text-indigo-400 hover:underline">
                Read the full MSW comparison →
              </a>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 p-6 bg-zinc-50 dark:bg-zinc-900/40">
            <h3 class="text-xl font-semibold text-zinc-900 dark:text-white mb-2">Faker.js factories</h3>
            <p class="text-zinc-600 dark:text-zinc-400 mb-4">
              Build reusable test data factories with Faker.js to generate realistic user objects, products, and more for your test suites.
            </p>
            <RunIt project="faker-factories" file="factory.test.js" title="Try Faker.js Factories Live" />
            <p class="mt-3 text-sm text-zinc-500">
              <a href="/guides/faker-js-test-data-factories/" class="text-indigo-600 dark:text-indigo-400 hover:underline">
                Read the full Faker.js guide →
              </a>
            </p>
          </div>
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl font-semibold text-zinc-900 dark:text-white mb-4">Demo API</h2>
        <p class="text-zinc-600 dark:text-zinc-400 mb-4">
          The examples use <strong>https://demo.devxtools.dev</strong>, a free shared fake REST API for testing and demos. No authentication required.
        </p>
        
        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 p-6 bg-zinc-50 dark:bg-zinc-900/40">
          <h3 class="text-lg font-semibold text-zinc-900 dark:text-white mb-3">Example endpoints</h3>
          <ul class="space-y-2 text-sm font-mono">
            <li>
              <a 
                href="https://demo.devxtools.dev/tasks/1" 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-indigo-600 dark:text-indigo-400 hover:underline inline-flex items-center gap-1"
              >
                /tasks/1
                <Icon name="arrow-up-right" size={14} />
              </a>
              <span class="text-zinc-500 ml-2">Get task #1</span>
            </li>
            <li>
              <a 
                href="https://demo.devxtools.dev/status/418" 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-indigo-600 dark:text-indigo-400 hover:underline inline-flex items-center gap-1"
              >
                /status/418
                <Icon name="arrow-up-right" size={14} />
              </a>
              <span class="text-zinc-500 ml-2">Returns HTTP 418</span>
            </li>
            <li>
              <a 
                href="https://demo.devxtools.dev/openapi.json" 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-indigo-600 dark:text-indigo-400 hover:underline inline-flex items-center gap-1"
              >
                /openapi.json
                <Icon name="arrow-up-right" size={14} />
              </a>
              <span class="text-zinc-500 ml-2">OpenAPI spec</span>
            </li>
          </ul>
        </div>
      </section>

      <footer class="pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <a 
          href="/guides/" 
          class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-5 py-2.5 font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900"
        >
          Browse all guides
          <Icon name="arrow-right" size={16} />
        </a>
      </footer>
    </article>
  </div>
</Layout>

<style>
  .container {
    min-width: 0;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import { getRecentReleases, getReleases, getReleaseHistory, releaseLinkLabel, renderSummaryHtml } from '../lib/releases';
import { getToolBySlug } from '../lib/tools';

const recentReleases = getRecentReleases(15);
const { lastUpdated } = getReleases();
const TZ = 'Europe/Stockholm';
---

<Layout 
  title="Changelog" 
  description="Updates, additions, and changes to the DevXTools catalog."
>
  <div class="container">
    <h1>Changelog</h1>
    <p class="subtitle">
      Track updates, new tools, and improvements to the catalog.
    </p>
    
    <div class="changelog">
      {recentReleases.length > 0 && (
        <article class="changelog-entry">
          <div class="changelog-header">
            <h2>Recent Releases</h2>
            {lastUpdated && (
              <time datetime={lastUpdated}>Updated {new Date(lastUpdated).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: TZ })}</time>
            )}
          </div>
          <div class="dx-prose rr">
            <p class="rr-intro">Latest stable releases from catalog tools:</p>
            <ul class="rr-list">
              {recentReleases.map(({ slug, release }) => {
                const tool = getToolBySlug(slug);
                if (!tool) return null;
                const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: TZ });
                const showSummary = release.status === 'reviewed' && !!release.summary;
                const showBadge = release.breaking && !(showSummary && /^breaking\b/i.test(release.summary ?? ''));
                const earlier = getReleaseHistory(slug, 5);
                return (
                  <li class="rr-item">
                    <div class="rr-head">
                      <a href={`/tools/${slug}/`} class="rr-name">{release.label ?? tool.name}</a>
                      <span class="rr-version">{release.version}</span>
                      {showBadge && <span class="rr-breaking">Breaking</span>}
                      <span class="rr-meta">
                        <time datetime={release.releaseDate}>{fmt(release.releaseDate)}</time>
                        <span class="rr-dot" aria-hidden="true">·</span>
                        <a href={release.releaseUrl} target="_blank" rel="noopener noreferrer">{releaseLinkLabel(release.releaseUrl)} ↗</a>
                      </span>
                    </div>
                    {showSummary && (
                      <p class="rr-summary"><Fragment set:html={renderSummaryHtml(release.summary!)} /></p>
                    )}
                    {earlier.length > 0 && (
                      <details class="rr-earlier">
                        <summary>Earlier releases ({earlier.length})</summary>
                        <ul>
                          {earlier.map(h => (
                            <li>
                              <div class="rr-head">
                                <span class="rr-version">{h.version}</span>
                                {h.breaking && <span class="rr-breaking">Breaking</span>}
                                <span class="rr-meta">
                                  <time datetime={h.releaseDate}>{fmt(h.releaseDate)}</time>
                                  <span class="rr-dot" aria-hidden="true">·</span>
                                  <a href={h.releaseUrl} target="_blank" rel="noopener noreferrer">{releaseLinkLabel(h.releaseUrl)} ↗</a>
                                </span>
                              </div>
                              {h.status === 'reviewed' && h.summary && (
                                <p class="rr-summary"><Fragment set:html={renderSummaryHtml(h.summary)} /></p>
                              )}
                            </li>
                          ))}
                        </ul>
                      </details>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        </article>
      )}
      
      <article class="changelog-entry">
        <div class="changelog-header">
          <h2>Initial Launch</h2>
          <time>October 14, 2026</time>
        </div>
        <div class="changelog-content">
          <h3>🎉 DevXTools v1.0</h3>
          <p>Welcome to DevXTools! We've launched with a comprehensive catalog of API mocking and test data tools.</p>
          
          <h4>Tools Added</h4>
          <ul>
            <li><strong>HTTP Interception:</strong> MSW, Nock, MirageJS</li>
            <li><strong>Mock Servers:</strong> WireMock, Mockoon, json-server, Mountebank</li>
            <li><strong>Spec-Based Mocking:</strong> Prism, Microcks</li>
            <li><strong>Record/Replay:</strong> Polly.js, Hoverfly, Mockifyer</li>
            <li><strong>Contract Testing:</strong> Pact</li>
            <li><strong>Test Data Generation:</strong> Faker, Chance, Fishery, Mockaroo</li>
            <li><strong>Hosted Mocks:</strong> Postman Mock Servers, Beeceptor</li>
          </ul>
          
          <h4>Features</h4>
          <ul>
            <li>Browse 19 curated tools across 7 categories</li>
            <li>Filter by language, category, and spec support</li>
            <li>Interactive tool picker to find the right solution</li>
            <li>Detailed comparison: MSW vs Nock vs Polly.js</li>
            <li>Guide stubs for upcoming tutorials</li>
            <li>Full SEO optimization with meta tags and sitemap</li>
          </ul>
          
          <h4>Documentation</h4>
          <ul>
            <li>Comprehensive README for contributors</li>
            <li>Schema validation for catalog entries</li>
            <li>GitHub Actions CI workflow</li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</Layout>

<style>
  .subtitle {
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }
  
  .changelog {
    max-width: 900px;
  }
  
  .changelog-entry {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  
  .changelog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  
  .changelog-header h2 {
    margin: 0;
    color: var(--accent);
  }
  
  .changelog-header time {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  
  .changelog-content h3 {
    margin-bottom: 1rem;
  }
  
  .changelog-content h4 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .changelog-content ul {
    margin-left: 2rem;
    margin-bottom: 1rem;
  }
  
  .changelog-content li {
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
  }
  
  @media (max-width: 768px) {
    .changelog-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
  /* Recent Releases: flat list inside the section card (no nested boxes) */
  .rr { max-width: none; }
  .rr > .rr-list, .rr > .rr-intro { max-width: none; }
  .rr .rr-intro {
    margin: 0 0 1.5rem;
    color: var(--dx-muted);
    font-size: 0.95rem;
    max-width: none;
  }
  .rr .rr-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--dx-border);
  }
  .rr .rr-item {
    margin: 0;
    padding: 1rem 0;
    border-bottom: 1px solid var(--dx-border);
    color: var(--dx-text);
  }
  .rr .rr-item::marker { content: none; }
  .rr .rr-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.625rem;
  }
  .rr .rr-name {
    font-weight: 600;
    color: var(--dx-heading);
    text-decoration: none;
  }
  .rr .rr-name:hover { color: var(--dx-accent); }
  .rr .rr-version {
    display: inline-flex;
    align-items: center;
    padding: 0.0625rem 0.5rem;
    border: 1px solid var(--dx-border);
    border-radius: 999px;
    background: var(--dx-surface-2);
    color: var(--dx-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }
  .rr .rr-breaking {
    display: inline-flex;
    padding: 0.0625rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
    background: #fee2e2;
    color: #991b1b;
  }
  :global(.dark) .rr .rr-breaking { background: rgb(127 29 29 / 0.6); color: #fecaca; }
  .rr .rr-meta {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--dx-subtle);
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .rr .rr-meta a { color: var(--dx-accent); text-decoration: none; }
  .rr .rr-meta a:hover { text-decoration: underline; }
  .rr .rr-summary {
    margin: 0.5rem 0 0;
    max-width: 68ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--dx-muted);
  }
  .rr .rr-earlier { margin-top: 0.625rem; font-size: 0.875rem; }
  .rr .rr-earlier > summary {
    cursor: pointer;
    color: var(--dx-subtle);
    width: fit-content;
  }
  .rr .rr-earlier > summary:hover { color: var(--dx-accent); }
  .rr .rr-earlier ul {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0 0 0 0.875rem;
    border-left: 2px solid var(--dx-border);
  }
  .rr .rr-earlier li { margin: 0; padding: 0.375rem 0; }
  .rr .rr-earlier li::marker { content: none; }
  .rr .rr-earlier .rr-summary { font-size: 0.875rem; margin-top: 0.25rem; }
  @media (max-width: 480px) {
    .rr .rr-meta { margin-left: 0; flex-basis: 100%; }
    .changelog-entry { padding: 1.25rem; }
  }
</style>

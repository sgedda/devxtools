---
import Layout from '../layouts/Layout.astro';
import { getRecentReleases, getReleases, renderSummaryHtml } from '../lib/releases';
import { getToolBySlug } from '../lib/tools';

const recentReleases = getRecentReleases(15);
const { lastUpdated } = getReleases();
const TZ = 'Europe/Stockholm';
---

<Layout 
  title="Changelog" 
  description="Updates, additions, and changes to the DevXTools catalog."
>
  <div class="container">
    <h1>Changelog</h1>
    <p class="subtitle">
      Track updates, new tools, and improvements to the catalog.
    </p>
    
    <div class="changelog">
      {recentReleases.length > 0 && (
        <article class="changelog-entry">
          <div class="changelog-header">
            <h2>Recent Releases</h2>
            {lastUpdated && (
              <time datetime={lastUpdated}>Updated {new Date(lastUpdated).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: TZ })}</time>
            )}
          </div>
          <div class="changelog-content">
            <p>Latest stable releases from catalog tools:</p>
            <ul class="releases-list">
              {recentReleases.map(({ slug, release }) => {
                const tool = getToolBySlug(slug);
                if (!tool) return null;
                
                const releaseDate = new Date(release.releaseDate);
                const formattedDate = releaseDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: TZ });
                const showSummary = release.status === 'reviewed' && !!release.summary;
                
                return (
                  <li>
                    <a href={`/tools/${slug}/`} class="release-link">
                      <strong>{release.label ?? tool.name}</strong> <span class="version">{release.version}</span>
                    </a>
                    <span class="release-meta">
                      · {formattedDate} · 
                      <a href={release.releaseUrl} target="_blank" rel="noopener noreferrer" class="release-notes-link">
                        {release.releaseUrl.startsWith('https://www.npmjs.com/') ? 'npm' : release.releaseUrl.startsWith('https://pypi.org/') ? 'PyPI' : 'Release notes'} ↗
                      </a>
                    </span>
                    {release.breaking && !showSummary && (
                      <span class="release-breaking">Breaking</span>
                    )}
                    {showSummary && (
                      <p class="release-summary">
                        {release.breaking && <span class="release-breaking">Breaking</span>}
                        <Fragment set:html={renderSummaryHtml(release.summary!)} />
                      </p>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        </article>
      )}
      
      <article class="changelog-entry">
        <div class="changelog-header">
          <h2>Initial Launch</h2>
          <time>October 14, 2026</time>
        </div>
        <div class="changelog-content">
          <h3>🎉 DevXTools v1.0</h3>
          <p>Welcome to DevXTools! We've launched with a comprehensive catalog of API mocking and test data tools.</p>
          
          <h4>Tools Added</h4>
          <ul>
            <li><strong>HTTP Interception:</strong> MSW, Nock, MirageJS</li>
            <li><strong>Mock Servers:</strong> WireMock, Mockoon, json-server, Mountebank</li>
            <li><strong>Spec-Based Mocking:</strong> Prism, Microcks</li>
            <li><strong>Record/Replay:</strong> Polly.js, Hoverfly, Mockifyer</li>
            <li><strong>Contract Testing:</strong> Pact</li>
            <li><strong>Test Data Generation:</strong> Faker, Chance, Fishery, Mockaroo</li>
            <li><strong>Hosted Mocks:</strong> Postman Mock Servers, Beeceptor</li>
          </ul>
          
          <h4>Features</h4>
          <ul>
            <li>Browse 19 curated tools across 7 categories</li>
            <li>Filter by language, category, and spec support</li>
            <li>Interactive tool picker to find the right solution</li>
            <li>Detailed comparison: MSW vs Nock vs Polly.js</li>
            <li>Guide stubs for upcoming tutorials</li>
            <li>Full SEO optimization with meta tags and sitemap</li>
          </ul>
          
          <h4>Documentation</h4>
          <ul>
            <li>Comprehensive README for contributors</li>
            <li>Schema validation for catalog entries</li>
            <li>GitHub Actions CI workflow</li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</Layout>

<style>
  .subtitle {
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }
  
  .changelog {
    max-width: 900px;
  }
  
  .changelog-entry {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  
  .changelog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  
  .changelog-header h2 {
    margin: 0;
    color: var(--accent);
  }
  
  .changelog-header time {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  
  .changelog-content h3 {
    margin-bottom: 1rem;
  }
  
  .changelog-content h4 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .changelog-content ul {
    margin-left: 2rem;
    margin-bottom: 1rem;
  }
  
  .changelog-content li {
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
  }
  
  .releases-list {
    list-style: none;
    margin-left: 0;
  }
  
  .releases-list li {
    margin-bottom: 1rem;
    padding: 0.75rem;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  
  .release-link {
    color: var(--text-primary);
    text-decoration: none;
    font-size: 1rem;
  }
  
  .release-link:hover {
    color: var(--accent);
  }
  
  .version {
    font-family: 'Courier New', monospace;
    background: var(--bg-secondary);
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    font-size: 0.9rem;
    color: var(--accent);
  }
  
  .release-meta {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-left: 0.5rem;
  }
  
  .release-notes-link {
    color: var(--accent);
    text-decoration: none;
  }
  
  .release-notes-link:hover {
    text-decoration: underline;
  }
  
  @media (max-width: 768px) {
    .changelog-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
  .release-summary {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .release-breaking {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    background: #fee2e2;
    color: #991b1b;
  }
  :global(.dark) .release-breaking {
    background: #7f1d1d;
    color: #fee2e2;
  }
</style>

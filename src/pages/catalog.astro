---
import Layout from '../layouts/Layout.astro';
import { getAllTools, getUniqueLanguages, getUniqueCategories } from '../lib/tools';
import { CATEGORY_LABELS } from '../lib/schema';

const tools = getAllTools();
const languages = getUniqueLanguages();
const categories = getUniqueCategories();

// Always use canonical /catalog/ URL regardless of filters
const canonicalURL = 'https://devxtools.dev/catalog/';
---

<Layout 
  title="Catalog" 
  description="Browse our complete catalog of API mocking and test data generation tools."
  canonicalURL={canonicalURL}
>
  <div class="container">
    <h1>Tool Catalog</h1>
    <p class="subtitle">
      Explore <span id="tool-count">{tools.length}</span> tools for API mocking, test data generation, and more.
      <span id="filter-status"></span>
    </p>
    
    <div class="filters">
      <div class="filter-group">
        <label>Category</label>
        <div class="filter-links" data-filter-type="category">
          <a href="/catalog/" data-filter-value="">All</a>
          {categories.map(cat => (
            <a 
              href={`/catalog/?category=${cat}`}
              data-filter-value={cat}
            >
              {CATEGORY_LABELS[cat as keyof typeof CATEGORY_LABELS]}
            </a>
          ))}
        </div>
      </div>
      
      <div class="filter-group">
        <label>Language</label>
        <div class="filter-links" data-filter-type="language">
          <a href="/catalog/" data-filter-value="">All</a>
          {languages.map(lang => (
            <a 
              href={`/catalog/?language=${lang}`}
              data-filter-value={lang}
            >
              {lang}
            </a>
          ))}
        </div>
      </div>
      
      <div class="filter-group">
        <label>Spec Support</label>
        <div class="filter-links" data-filter-type="spec">
          <a href="/catalog/" data-filter-value="">Any</a>
          <a href="/catalog/?spec=has-spec" data-filter-value="has-spec">
            Has Spec Support
          </a>
          <a href="/catalog/?spec=OpenAPI" data-filter-value="OpenAPI">
            OpenAPI
          </a>
        </div>
      </div>
      
      <div class="filter-group">
        <a href="/catalog/" id="reset-filters" class="button button-secondary" style="display: none;">Reset Filters</a>
      </div>
    </div>
    
    <div class="tool-list">
      <p class="no-results" id="no-results" style="display: none;">No tools match your filters. <a href="/catalog/">View all tools</a></p>
      {tools.map(tool => (
          <article 
            class="tool-item"
            data-categories={tool.categories.join(',')}
            data-languages={tool.languages.join(',')}
            data-spec-support={tool.specSupport ? tool.specSupport.join(',') : ''}
          >
            <div class="tool-header">
              <h2><a href={`/tools/${tool.slug}/`}>{tool.name}</a></h2>
              {tool.license && <span class="license">{tool.license}</span>}
            </div>
            
            <p class="tool-description">{tool.description}</p>
            
            <div class="tool-meta">
              <div class="meta-section">
                <strong>Best for:</strong> {tool.bestFor}
              </div>
              
              <div class="meta-section">
                <strong>Languages:</strong>
                {tool.languages.map(lang => (
                  <span class="badge">{lang}</span>
                ))}
              </div>
              
              <div class="meta-section">
                <strong>Categories:</strong>
                {tool.categories.map(cat => (
                  <span class="badge">{CATEGORY_LABELS[cat]}</span>
                ))}
              </div>
              
              {tool.specSupport && tool.specSupport.length > 0 && (
                <div class="meta-section">
                  <strong>Spec Support:</strong>
                  {tool.specSupport.map(spec => (
                    <span class="badge badge-success">{spec}</span>
                  ))}
                </div>
              )}
            </div>
            
            <div class="tool-links">
              <a href={tool.website} target="_blank" rel="noopener noreferrer">Website →</a>
              {tool.repo && (
                <a href={tool.repo} target="_blank" rel="noopener noreferrer">Repository →</a>
              )}
              <a href={`/tools/${tool.slug}/`}>Details →</a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
  
  <script>
    // Client-side filtering
    const params = new URLSearchParams(window.location.search);
    const categoryFilter = params.get('category') || '';
    const languageFilter = params.get('language') || '';
    const specFilter = params.get('spec') || '';
    
    function applyFilters() {
      const tools = document.querySelectorAll('.tool-item');
      let visibleCount = 0;
      
      tools.forEach(tool => {
        const categories = tool.getAttribute('data-categories')?.split(',') || [];
        const languages = tool.getAttribute('data-languages')?.split(',') || [];
        const specSupport = tool.getAttribute('data-spec-support')?.split(',').filter(Boolean) || [];
        
        let matches = true;
        
        if (categoryFilter && !categories.includes(categoryFilter)) {
          matches = false;
        }
        
        if (languageFilter && !languages.includes(languageFilter)) {
          matches = false;
        }
        
        if (specFilter === 'has-spec' && specSupport.length === 0) {
          matches = false;
        } else if (specFilter && specFilter !== 'has-spec' && !specSupport.includes(specFilter)) {
          matches = false;
        }
        
        if (matches) {
          tool.style.display = '';
          visibleCount++;
        } else {
          tool.style.display = 'none';
        }
      });
      
      // Update count and filter status
      const countEl = document.getElementById('tool-count');
      const statusEl = document.getElementById('filter-status');
      const noResultsEl = document.getElementById('no-results');
      const resetBtn = document.getElementById('reset-filters');
      
      if (countEl) countEl.textContent = visibleCount.toString();
      
      if (categoryFilter || languageFilter || specFilter) {
        if (statusEl) statusEl.textContent = ` (Showing ${visibleCount} filtered results)`;
        if (resetBtn) resetBtn.style.display = '';
      } else {
        if (statusEl) statusEl.textContent = '';
        if (resetBtn) resetBtn.style.display = 'none';
      }
      
      if (noResultsEl) {
        noResultsEl.style.display = visibleCount === 0 ? '' : 'none';
      }
    }
    
    // Set active states
    document.querySelectorAll('.filter-links a').forEach(link => {
      const filterValue = link.getAttribute('data-filter-value');
      const filterType = link.parentElement?.getAttribute('data-filter-type');
      
      if (filterType === 'category' && filterValue === categoryFilter) {
        link.classList.add('active');
      } else if (filterType === 'language' && filterValue === languageFilter) {
        link.classList.add('active');
      } else if (filterType === 'spec' && filterValue === specFilter) {
        link.classList.add('active');
      } else if (!filterValue && 
                 ((filterType === 'category' && !categoryFilter) ||
                  (filterType === 'language' && !languageFilter) ||
                  (filterType === 'spec' && !specFilter))) {
        link.classList.add('active');
      }
    });
    
    applyFilters();
  </script>
</Layout>

<style>
  .subtitle {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
  
  .filters {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .filter-group label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .filter-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .filter-links a {
    padding: 0.5rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s;
  }
  
  .filter-links a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  
  .filter-links a.active {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }
  
  .button-secondary {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
  }
  
  .button-secondary:hover {
    background: var(--border);
  }
  
  .tool-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .tool-item {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
  }
  
  .tool-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  
  .tool-header h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  
  .tool-header a {
    color: var(--text);
    text-decoration: none;
  }
  
  .tool-header a:hover {
    color: var(--accent);
  }
  
  .license {
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding: 0.25rem 0.75rem;
    background: var(--bg);
    border-radius: 12px;
  }
  
  .tool-description {
    color: var(--text);
    margin-bottom: 1rem;
  }
  
  .tool-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding: 1rem;
    background: var(--bg);
    border-radius: 6px;
  }
  
  .meta-section {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  
  .meta-section strong {
    color: var(--text-secondary);
    font-size: 0.875rem;
    min-width: 100px;
  }
  
  .tool-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .tool-links a {
    color: var(--accent);
    font-size: 0.95rem;
  }
  
  .no-results {
    text-align: center;
    padding: 3rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  
  @media (max-width: 768px) {
    .filters {
      flex-direction: column;
    }
    
    .filter-links {
      width: 100%;
    }
    
    .tool-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>

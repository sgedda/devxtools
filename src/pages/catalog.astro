---
import Layout from '../layouts/Layout.astro';
import { getAllTools, getUniqueLanguages, getUniqueCategories } from '../lib/tools';
import { CATEGORY_LABELS } from '../lib/schema';

const tools = getAllTools();
const languages = getUniqueLanguages();
const categories = getUniqueCategories();

const canonicalURL = 'https://devxtools.dev/catalog/';
---

<Layout 
  title="Catalog" 
  description="Browse our complete catalog of API mocking and test data generation tools."
  canonicalURL={canonicalURL}
>
  <div class="container">
    <h1>Tool Catalog</h1>
    <p class="subtitle">
      Explore <span id="tool-count">{tools.length}</span> tools for API mocking, test data generation, and more.
    </p>
    
    <div class="filters">
      <div class="filter-group">
        <label>Category</label>
        <div class="filter-links" id="category-filters">
          <button class="filter-btn active" data-filter="category" data-value="">All</button>
          {categories.map(cat => (
            <button class="filter-btn" data-filter="category" data-value={cat}>
              {CATEGORY_LABELS[cat as keyof typeof CATEGORY_LABELS]}
            </button>
          ))}
        </div>
      </div>
      
      <div class="filter-group">
        <label>Language</label>
        <div class="filter-links" id="language-filters">
          <button class="filter-btn active" data-filter="language" data-value="">All</button>
          {languages.map(lang => (
            <button class="filter-btn" data-filter="language" data-value={lang}>
              {lang}
            </button>
          ))}
        </div>
      </div>
      
      <div class="filter-group">
        <label>Spec Support</label>
        <div class="filter-links" id="spec-filters">
          <button class="filter-btn active" data-filter="spec" data-value="">Any</button>
          <button class="filter-btn" data-filter="spec" data-value="has-spec">
            Has Spec Support
          </button>
          <button class="filter-btn" data-filter="spec" data-value="OpenAPI">
            OpenAPI
          </button>
        </div>
      </div>
      
      <div class="filter-group" id="reset-filter-group" style="display: none;">
        <button id="reset-filters" class="button button-secondary">Reset Filters</button>
      </div>
    </div>
    
    <p class="no-results" id="no-results" style="display: none;">No tools match your filters.</p>
    
    <div class="tool-list" id="tool-list">
      {tools.map(tool => (
        <article 
          class="tool-item" 
          data-categories={tool.categories.join(',')}
          data-languages={tool.languages.join(',')}
          data-specs={tool.specSupport?.join(',') || ''}
        >
          <div class="tool-header">
            <h2><a href={`/tools/${tool.slug}/`}>{tool.name}</a></h2>
            {tool.license && <span class="license">{tool.license}</span>}
          </div>
          
          <p class="tool-description">{tool.description}</p>
          
          <div class="tool-meta">
            <div class="meta-section">
              <strong>Best for:</strong> {tool.bestFor}
            </div>
            
            <div class="meta-section">
              <strong>Languages:</strong>
              {tool.languages.map(lang => (
                <span class="badge">{lang}</span>
              ))}
            </div>
            
            <div class="meta-section">
              <strong>Categories:</strong>
              {tool.categories.map(cat => (
                <span class="badge">{CATEGORY_LABELS[cat]}</span>
              ))}
            </div>
            
            {tool.specSupport && tool.specSupport.length > 0 && (
              <div class="meta-section">
                <strong>Spec Support:</strong>
                {tool.specSupport.map(spec => (
                  <span class="badge badge-success">{spec}</span>
                ))}
              </div>
            )}
          </div>
          
          <div class="tool-links">
            <a href={tool.website} target="_blank" rel="noopener noreferrer">Website →</a>
            {tool.repo && (
              <a href={tool.repo} target="_blank" rel="noopener noreferrer">Repository →</a>
            )}
            <a href={`/tools/${tool.slug}/`}>Details →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<script>
  const filters = {
    category: '',
    language: '',
    spec: ''
  };

  function updateFilters() {
    const toolItems = document.querySelectorAll('.tool-item') as NodeListOf<HTMLElement>;
    let visibleCount = 0;

    toolItems.forEach(item => {
      const categories = item.dataset.categories?.split(',') || [];
      const languages = item.dataset.languages?.split(',') || [];
      const specs = item.dataset.specs?.split(',').filter(s => s) || [];

      const matchesCategory = !filters.category || categories.includes(filters.category);
      const matchesLanguage = !filters.language || languages.includes(filters.language);
      const matchesSpec = !filters.spec || 
        (filters.spec === 'has-spec' && specs.length > 0) ||
        specs.includes(filters.spec);

      const isVisible = matchesCategory && matchesLanguage && matchesSpec;
      item.style.display = isVisible ? '' : 'none';
      if (isVisible) visibleCount++;
    });

    const toolCount = document.getElementById('tool-count');
    if (toolCount) toolCount.textContent = visibleCount.toString();

    const noResults = document.getElementById('no-results');
    if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';

    const resetGroup = document.getElementById('reset-filter-group');
    const hasFilters = filters.category || filters.language || filters.spec;
    if (resetGroup) resetGroup.style.display = hasFilters ? 'block' : 'none';

    updateURL();
  }

  function updateURL() {
    const params = new URLSearchParams();
    if (filters.category) params.set('category', filters.category);
    if (filters.language) params.set('language', filters.language);
    if (filters.spec) params.set('spec', filters.spec);
    
    const newURL = params.toString() ? `/catalog/?${params.toString()}` : '/catalog/';
    window.history.replaceState({}, '', newURL);
  }

  function initFiltersFromURL() {
    const params = new URLSearchParams(window.location.search);
    filters.category = params.get('category') || '';
    filters.language = params.get('language') || '';
    filters.spec = params.get('spec') || '';

    document.querySelectorAll('.filter-btn').forEach(btn => {
      const filterType = (btn as HTMLElement).dataset.filter;
      const filterValue = (btn as HTMLElement).dataset.value || '';
      if (filterType && filters[filterType as keyof typeof filters] === filterValue) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    updateFilters();
  }

  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const filterType = (btn as HTMLElement).dataset.filter as keyof typeof filters;
      const filterValue = (btn as HTMLElement).dataset.value || '';

      filters[filterType] = filterValue;

      const filterGroup = btn.parentElement;
      if (filterGroup) {
        filterGroup.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      }
      btn.classList.add('active');

      updateFilters();
    });
  });

  const resetBtn = document.getElementById('reset-filters');
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      filters.category = '';
      filters.language = '';
      filters.spec = '';

      document.querySelectorAll('.filter-btn').forEach(btn => {
        const filterValue = (btn as HTMLElement).dataset.value;
        if (!filterValue) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      updateFilters();
    });
  }

  initFiltersFromURL();
</script>

<style>
  .subtitle {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
  
  .filters {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .filter-group label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .filter-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .filter-btn {
    padding: 0.5rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  
  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  
  .filter-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }
  
  .button-secondary {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
  }
  
  .button-secondary:hover {
    background: var(--border);
  }
  
  .tool-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .tool-item {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
  }
  
  .tool-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  
  .tool-header h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  
  .tool-header a {
    color: var(--text);
    text-decoration: none;
  }
  
  .tool-header a:hover {
    color: var(--accent);
  }
  
  .license {
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding: 0.25rem 0.75rem;
    background: var(--bg);
    border-radius: 12px;
  }
  
  .tool-description {
    color: var(--text);
    margin-bottom: 1rem;
  }
  
  .tool-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding: 1rem;
    background: var(--bg);
    border-radius: 6px;
  }
  
  .meta-section {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  
  .meta-section strong {
    color: var(--text-secondary);
    font-size: 0.875rem;
    min-width: 100px;
  }
  
  .tool-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .tool-links a {
    color: var(--accent);
    font-size: 0.95rem;
  }
  
  .no-results {
    text-align: center;
    padding: 3rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  
  @media (max-width: 768px) {
    .filters {
      flex-direction: column;
    }
    
    .filter-links {
      width: 100%;
    }
    
    .tool-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>

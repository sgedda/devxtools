---
import { existingArticleOgCard } from '../lib/article-og';
import Icon from '../components/Icon.astro';
import { getAllTools } from '../lib/tools';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: any;
}

const { title, description, canonicalURL, noindex = false, jsonLd } = Astro.props;
// Article pages use their own card (guides/comparisons); everything else falls back to the default.
const ogImage = Astro.props.ogImage ?? existingArticleOgCard(canonicalURL || Astro.url.pathname) ?? '/og-image.png';
// Brand suffix only when it fits: SERPs cut titles at ~60 characters.
const SITE = 'https://devxtools.dev/';
// Sitewide brand entities (one @graph on every page). Page JSON-LD stays in its own script.
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}#website`,
      name: 'DevXTools',
      alternateName: ['DevX Tools', 'devxtools.dev'],
      url: SITE,
      description: 'A curated guide to API development, mocking, testing, and test data generation tools for developers.',
      publisher: { '@id': `${SITE}#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE}#organization`,
      name: 'DevXTools',
      url: SITE,
      logo: { '@type': 'ImageObject', url: `${SITE}favicon-512.png`, width: 512, height: 512 },
      sameAs: ['https://github.com/sgedda/devxtools'],
    },
  ],
};
const siteTitle = (title.includes('DevXTools') || title.includes('DevXTools') || title.length + 12 > 60) ? title : `${title} | DevXTools`;
const allTools = getAllTools();

const normalizedCanonical = canonicalURL || `https://devxtools.dev${Astro.url.pathname}${Astro.url.pathname.endsWith('/') ? '' : '/'}`;

const isPreviewDeploy = import.meta.env.CF_PAGES_BRANCH 
  ? import.meta.env.CF_PAGES_BRANCH !== 'main'
  : Astro.url.hostname !== 'devxtools.dev' && Astro.url.hostname !== 'localhost';

const currentPath = Astro.url.pathname;
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={normalizedCanonical} />
    <meta name="generator" content={Astro.generator} />
    {isPreviewDeploy && <meta name="robots" content="noindex, nofollow" />}
    {!isPreviewDeploy && noindex && <meta name="robots" content="noindex, follow" />}
    <slot name="head" />
    
    <script is:inline>
      // Initialize theme before render to prevent flash
      if (localStorage.theme === 'dark' || (!localStorage.theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
    
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DevXTools" />
    <meta property="og:url" content={normalizedCanonical} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={normalizedCanonical} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    
    <link rel="alternate" type="application/rss+xml" title="DevXTools" href="/rss.xml" />
    
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    
    <script is:inline define:vars={{ allTools }}>
      window.__TOOLS__ = allTools;
    </script>
    
    {cfBeaconToken && <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon={`{"token": "${cfBeaconToken}"}`}></script>}
  </head>
  <body class="bg-white text-zinc-800 antialiased dark:bg-zinc-950 dark:text-zinc-300">
    <header class="sticky top-0 z-40 border-b border-zinc-200/80 bg-white/80 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/80">
      <div class="mx-auto flex h-16 max-w-[1200px] items-center gap-4 px-5">
        <a href="/" class="flex items-center gap-2 font-semibold text-zinc-900 dark:text-white" aria-label="DevXTools home">
          <img src="/logo-light.svg" alt="DevXTools" class="h-8 dark:hidden" />
          <img src="/logo-dark.svg" alt="DevXTools" class="h-8 hidden dark:block" />
        </a>
        <nav class="ml-4 hidden items-center gap-1 lg:flex">
          <a 
            href="/catalog/" 
            class={`px-3 py-1.5 rounded-md text-[15px] font-medium ${currentPath.startsWith('/catalog') ? 'text-zinc-900 bg-zinc-100 dark:text-white dark:bg-zinc-800' : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800/60'}`}
          >
            Catalog
          </a>
          <a 
            href="/comparisons/" 
            class={`px-3 py-1.5 rounded-md text-[15px] font-medium ${currentPath.startsWith('/comparisons') ? 'text-zinc-900 bg-zinc-100 dark:text-white dark:bg-zinc-800' : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800/60'}`}
          >
            Comparisons
          </a>
          <a 
            href="/guides/" 
            class={`px-3 py-1.5 rounded-md text-[15px] font-medium ${currentPath.startsWith('/guides') ? 'text-zinc-900 bg-zinc-100 dark:text-white dark:bg-zinc-800' : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800/60'}`}
          >
            Guides
          </a>
          <a 
            href="/demos/" 
            class={`px-3 py-1.5 rounded-md text-[15px] font-medium ${currentPath.startsWith('/demos') ? 'text-zinc-900 bg-zinc-100 dark:text-white dark:bg-zinc-800' : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800/60'}`}
          >
            Demos
          </a>
          <a 
            href="/picker/" 
            class={`px-3 py-1.5 rounded-md text-[15px] font-medium ${currentPath.startsWith('/picker') ? 'text-zinc-900 bg-zinc-100 dark:text-white dark:bg-zinc-800' : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800/60'}`}
          >
            Pick a Tool
          </a>
          <a 
            href="/changelog/" 
            class={`px-3 py-1.5 rounded-md text-[15px] font-medium ${currentPath.startsWith('/changelog') ? 'text-zinc-900 bg-zinc-100 dark:text-white dark:bg-zinc-800' : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800/60'}`}
          >
            Changelog
          </a>
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <button 
            id="search-button" 
            class="hidden md:flex items-center gap-2 w-60 rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-1.5 text-sm text-zinc-500 hover:border-zinc-300 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400"
          >
            <Icon name="search" size={16} />
            Search tools…
            <kbd class="ml-auto rounded border border-zinc-300 bg-white px-1.5 text-[11px] font-mono dark:border-zinc-700 dark:bg-zinc-800">⌘K</kbd>
          </button>
          <button 
            id="mobile-search-button"
            class="md:hidden p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300" 
            aria-label="Search"
          >
            <Icon name="search" size={20} />
          </button>
          <button 
            id="theme-toggle" 
            class="p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300" 
            aria-label="Toggle theme"
          >
            <Icon name="moon" class="dark:hidden" size={20} />
            <Icon name="sun" class="hidden dark:block" size={20} />
          </button>
          <a 
            href="https://github.com/sgedda/devxtools" 
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300" 
            aria-label="GitHub"
          >
            <Icon name="git-fork" size={20} />
          </a>
          <button 
            id="mobile-menu-button"
            class="lg:hidden p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300" 
            aria-label="Menu"
          >
            <Icon name="menu" size={20} />
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="hidden lg:hidden border-t border-zinc-200 dark:border-zinc-800 px-5 py-3 space-y-1">
        <a 
          href="/catalog/" 
          class={`block px-3 py-2.5 rounded-lg text-[15px] font-medium ${currentPath.startsWith('/catalog') ? 'text-zinc-900 bg-zinc-100 dark:text-white dark:bg-zinc-800' : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800/60'}`}
        >
          Catalog
        </a>
        <a 
          href="/comparisons/" 
          class={`block px-3 py-2.5 rounded-lg text-[15px] font-medium ${currentPath.startsWith('/comparisons') ? 'text-zinc-900 bg-zinc-100 dark:text-white dark:bg-zinc-800' : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800/60'}`}
        >
          Comparisons
        </a>
        <a 
          href="/guides/" 
          class={`block px-3 py-2.5 rounded-lg text-[15px] font-medium ${currentPath.startsWith('/guides') ? 'text-zinc-900 bg-zinc-100 dark:text-white dark:bg-zinc-800' : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800/60'}`}
        >
          Guides
        </a>
        <a 
          href="/demos/" 
          class={`block px-3 py-2.5 rounded-lg text-[15px] font-medium ${currentPath.startsWith('/demos') ? 'text-zinc-900 bg-zinc-100 dark:text-white dark:bg-zinc-800' : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800/60'}`}
        >
          Demos
        </a>
        <a 
          href="/picker/" 
          class={`block px-3 py-2.5 rounded-lg text-[15px] font-medium ${currentPath.startsWith('/picker') ? 'text-zinc-900 bg-zinc-100 dark:text-white dark:bg-zinc-800' : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800/60'}`}
        >
          Pick a Tool
        </a>
        <a 
          href="/changelog/" 
          class={`block px-3 py-2.5 rounded-lg text-[15px] font-medium ${currentPath.startsWith('/changelog') ? 'text-zinc-900 bg-zinc-100 dark:text-white dark:bg-zinc-800' : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800/60'}`}
        >
          Changelog
        </a>
      </nav>
    </header>

    <div id="search-dialog" class="hidden fixed inset-0 z-50 bg-zinc-950/40 backdrop-blur-sm p-4 pt-[12vh]">
      <div class="mx-auto max-w-xl overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">
        <div class="flex items-center gap-3 border-b border-zinc-200 px-4 dark:border-zinc-800">
          <Icon name="search" size={20} class="text-zinc-400" />
          <input 
            id="search-input"
            placeholder="Search 24 tools, categories, guides…" 
            class="h-14 flex-1 bg-transparent text-base outline-none text-zinc-900 dark:text-white"
          />
          <kbd class="text-xs text-zinc-400">ESC</kbd>
        </div>
        <ul id="search-results" class="max-h-80 overflow-auto p-2"></ul>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/40">
      <div class="mx-auto max-w-[1200px] px-5 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <div class="flex items-center gap-2 font-semibold text-zinc-900 dark:text-white">
            <img src="/logo-light.svg" alt="DevXTools" class="h-8 dark:hidden" />
            <img src="/logo-dark.svg" alt="DevXTools" class="h-8 hidden dark:block" />
          </div>
          <p class="mt-3 max-w-sm text-[15px] text-zinc-600 dark:text-zinc-400">
            An independent, neutral guide to API development, testing, and mocking tools. No sponsored rankings.
          </p>
          <form 
            id="newsletter-form"
            class="mt-5 flex flex-col sm:flex-row max-w-sm gap-2"
            method="POST"
            action="/api/newsletter/signup"
          >
            <input 
              type="email"
              name="email"
              placeholder="you@company.com" 
              required
              class="flex-1 min-w-0 rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm dark:border-zinc-700 dark:bg-zinc-900"
            />
            <input
              type="text"
              name="website"
              class="hidden"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />
            <input type="hidden" name="consent" value="true" />
            <input type="hidden" name="source" value={Astro.url.pathname} />
            <input type="hidden" name="placement" value="footer" />
            <button 
              type="submit"
              class="rounded-lg bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200 whitespace-nowrap"
            >
              Subscribe
            </button>
          </form>
          <div id="newsletter-status" class="mt-2 text-sm"></div>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Explore</h4>
          <ul class="mt-3 space-y-2">
            <li><a href="/catalog/" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Catalog</a></li>
            <li><a href="/picker/" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Pick a Tool</a></li>
            <li><a href="/comparisons/" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Comparisons</a></li>
            <li><a href="/demos/" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Demos</a></li>
            <li><a href="/polls/" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Polls</a></li>
            <li><a href="/changelog/" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Changelog</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Guides</h4>
          <ul class="mt-3 space-y-2">
            <li><a href="/guides/" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">All guides</a></li>
            <li><a href="/guides/" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Tutorials</a></li>
            <li><a href="/guides/" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Best practices</a></li>
            <li><a href="/guides/" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Comparisons</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Project</h4>
          <ul class="mt-3 space-y-2">
            <li><a href="/about/" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">About</a></li>
            <li><a href="/rss.xml" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">RSS Feed</a></li>
            <li><a href="https://github.com/sgedda/devxtools" target="_blank" rel="noopener noreferrer" class="text-[15px] text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Contribute on GitHub</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-zinc-200 dark:border-zinc-800">
        <div class="mx-auto max-w-[1200px] px-5 py-5 text-sm text-zinc-600 dark:text-zinc-400">
          © 2026 DevXTools · Last data check 2026-10-14
        </div>
      </div>
    </footer>

    <script is:inline>
      // Wide diagrams scroll inside their frame on phones: start centred on the top node.
      const dxCenterDiagrams = () => document.querySelectorAll('.dx-diagram .dx-figure__frame').forEach((f) => {
        if (f.scrollWidth > f.clientWidth) f.scrollLeft = (f.scrollWidth - f.clientWidth) / 2;
      });
      dxCenterDiagrams();
      // Tap-to-open target follows the theme (system dark sets .dark too).
      const dxDiagramLinks = () => {
        const mode = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        document.querySelectorAll('.dx-diagram a.dx-figure__frame').forEach((a) => {
          a.href = a.getAttribute('href').replace(/-(light|dark)\.svg$/, `-${mode}.svg`);
        });
      };
      dxDiagramLinks();
      new MutationObserver(dxDiagramLinks).observe(document.documentElement, { attributeFilter: ['class'] });
      addEventListener('load', dxCenterDiagrams);
      addEventListener('resize', dxCenterDiagrams);
    </script>
    <script is:inline>
      // Theme toggle
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.theme = isDark ? 'dark' : 'light';
      });

      // Mobile menu toggle
      document.getElementById('mobile-menu-button')?.addEventListener('click', () => {
        document.getElementById('mobile-nav')?.classList.toggle('hidden');
      });

      // Search dialog
      const searchDialog = document.getElementById('search-dialog');
      const searchInput = document.getElementById('search-input');
      const searchResults = document.getElementById('search-results');
      
      // Load tools data for search (inline to avoid fetch)
      const TOOLS = window.__TOOLS__ || [];
      
      const openSearch = () => {
        searchDialog?.classList.remove('hidden');
        setTimeout(() => searchInput?.focus(), 10);
      };
      
      const closeSearch = () => {
        searchDialog?.classList.add('hidden');
        if (searchInput) searchInput.value = '';
        if (searchResults) searchResults.innerHTML = '';
      };
      
      // Perform search
      const performSearch = (query) => {
        if (!searchResults) return;
        
        if (!query.trim()) {
          searchResults.innerHTML = '';
          return;
        }
        
        const lowerQuery = query.toLowerCase();
        const matches = TOOLS.filter(tool => 
          tool.name.toLowerCase().includes(lowerQuery) ||
          tool.description.toLowerCase().includes(lowerQuery) ||
          tool.bestFor.toLowerCase().includes(lowerQuery)
        ).slice(0, 8);
        
        if (matches.length === 0) {
          searchResults.innerHTML = '<li class="px-3 py-8 text-center text-sm text-zinc-500">No tools found</li>';
          return;
        }
        
        searchResults.innerHTML = matches.map(tool => `
          <li>
            <a href="/tools/${tool.slug}/" class="flex items-center gap-3 rounded-lg px-3 py-2.5 hover:bg-zinc-100 dark:hover:bg-zinc-800">
              <div class="flex-1 min-w-0">
                <div class="font-medium text-zinc-900 dark:text-white">${tool.name}</div>
                <div class="text-sm text-zinc-500 truncate">${tool.bestFor}</div>
              </div>
            </a>
          </li>
        `).join('');
      };
      
      searchInput?.addEventListener('input', (e) => {
        performSearch(e.target.value);
      });
      
      document.getElementById('search-button')?.addEventListener('click', openSearch);
      document.getElementById('mobile-search-button')?.addEventListener('click', openSearch);
      
      searchDialog?.addEventListener('click', (e) => {
        if (e.target === searchDialog) closeSearch();
      });
      
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          openSearch();
        }
        if (e.key === 'Escape') closeSearch();
      });

      // Newsletter form
      const newsletterForm = document.getElementById('newsletter-form');
      const newsletterStatus = document.getElementById('newsletter-status');
      
      newsletterForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(newsletterForm);
        const button = newsletterForm.querySelector('button[type="submit"]');
        
        if (button) button.disabled = true;
        if (newsletterStatus) {
          newsletterStatus.textContent = 'Subscribing...';
          newsletterStatus.className = 'mt-2 text-sm text-zinc-500';
        }
        
        try {
          const response = await fetch('/api/newsletter/signup', {
            method: 'POST',
            body: formData,
          });
          
          const result = await response.json();
          
          if (response.ok) {
            if (newsletterStatus) {
              newsletterStatus.textContent = result.message || 'Check your email to confirm!';
              newsletterStatus.className = 'mt-2 text-sm text-emerald-600 dark:text-emerald-400';
            }
            newsletterForm.querySelector('input[name="email"]').value = '';
          } else {
            if (newsletterStatus) {
              newsletterStatus.textContent = result.error || 'Something went wrong';
              newsletterStatus.className = 'mt-2 text-sm text-amber-600 dark:text-amber-400';
            }
          }
        } catch (error) {
          if (newsletterStatus) {
            newsletterStatus.textContent = 'Network error. Please try again.';
            newsletterStatus.className = 'mt-2 text-sm text-amber-600 dark:text-amber-400';
          }
        } finally {
          if (button) button.disabled = false;
        }
      });

      // Table and diagram overflow state
      (() => {
        const update = (box, sc) => {
          const max = sc.scrollWidth - sc.clientWidth;
          if (max <= 1) { box.removeAttribute('data-overflow'); box.removeAttribute('data-scrolled'); sc.removeAttribute('tabindex'); return; }
          sc.setAttribute('tabindex', '0');
          const x = Math.abs(sc.scrollLeft);
          box.dataset.overflow = x < 2 ? 'end' : x >= max - 2 ? 'start' : 'both';
          box.toggleAttribute('data-scrolled', x > 2);
        };
        // diagram frames: tab stop only when they actually scroll
        document.querySelectorAll('.dx-diagram .dx-figure__frame').forEach(f => {
          const run = () => f.scrollWidth > f.clientWidth + 1 ? f.setAttribute('tabindex','0') : f.removeAttribute('tabindex');
          new ResizeObserver(run).observe(f); run();
        });
        document.querySelectorAll('.dx-table').forEach(box => {
          const sc = box.querySelector('.dx-table__scroll');
          const run = () => update(box, sc);
          sc.addEventListener('scroll', run, { passive: true });
          new ResizeObserver(run).observe(sc);
          run();
        });
      })();
    </script>
  </body>
</html>

{
  "name": "devxtools",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:og && npm run check:og:articles && npm run validate:releases && astro build && npm run validate:llms-txt",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "tsx scripts/validate-catalog.ts",
    "validate:releases": "tsx scripts/validate-releases.ts",
    "validate:demos": "tsx scripts/validate-demos.ts",
    "validate:llms-txt": "tsx scripts/validate-llms-txt.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:viewport": "playwright test viewport-overflow.spec.ts",
    "fetch-releases": "tsx scripts/fetch-releases.ts",
    "og": "tsx scripts/generate-og-cards.ts",
    "check:og": "tsx scripts/check-og-cards.ts",
    "og:articles": "tsx scripts/generate-article-og-cards.ts",
    "check:og:articles": "tsx scripts/check-article-og-cards.ts",
    "postinstall": "node -e \"if (process.env.CF_PAGES) { console.log('Skipping Playwright install on Cloudflare Pages'); process.exit(0); }\" || npx playwright install --with-deps chromium || true"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "enhanced-resolve": "^5.26.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.30",
    "puppeteer-core": "^25.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
